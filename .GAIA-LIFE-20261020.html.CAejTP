}*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;width:100%;height:100%;overflow:hidden;overscroll-behavior:none;background:#f2e7da;font-family:Gaia,'Noto Sans KR',system-ui,sans-serif;color:#69435a;user-select:none}button,input,select{font:inherit}button{touch-action:manipulation;color:inherit;cursor:pointer}button:disabled{opacity:.4}button:focus-visible{outline:3px solid #ad6994;outline-offset:3px}[hidden]{display:none!important}#stage{position:absolute;inset:0;width:100%;height:100%;touch-action:none}#fieldUI{position:absolute;inset:0;pointer-events:none;z-index:3}#fieldUI button{pointer-events:auto}#heroHUD{position:absolute;left:max(8px,env(safe-area-inset-left));top:max(8px,env(safe-area-inset-top));width:230px;height:88px;border:0;background:none;padding:0;display:flex;align-items:center;text-align:left;filter:drop-shadow(0 2px 3px #6c34452a)}.avatar{position:relative;width:78px;height:84px;flex:none;background:#f6dfd5;border-radius:24px}.avatar img{position:absolute;left:12%;top:12%;width:76%;height:74%;object-fit:cover;object-position:center 8%;border-radius:23px}.avatar::after{content:'';position:absolute;inset:0;background:var(--ui-frame) center/100% 100% no-repeat;pointer-events:none}.resource{flex:1;display:grid;gap:6px;background:#fff0dcc7;padding:9px 10px 9px 7px;margin-left:-5px;border-radius:0 12px 12px 0;border:1px solid #e2b58c}.meter{height:19px;position:relative;overflow:hidden;border-radius:15px;background:#dbc5c0}.meter i{display:block;height:100%;border-radius:15px;transition:width .25s;background:linear-gradient(#ffa8c8,#da608f)}.meter.mp i{background:linear-gradient(#c9bbef,#9a7bc7)}.meter span{position:absolute;inset:0;display:flex;justify-content:space-between;align-items:center;padding:0 8px;color:#fff9f0;font-size:11px;font-weight:700;text-shadow:0 1px #8a5276}#wallet{position:absolute;right:72px;top:20px;text-align:right;font-size:14px;text-shadow:0 1px #fff9}#wallet small{display:block;font-size:10px}#location{position:absolute;top:22px;left:50%;transform:translateX(-50%);font-size:13px;background:#fff4e4bd;padding:5px 14px;border-radius:20px}#menu{position:absolute;right:10px;top:8px;width:54px;height:60px;border:0;background:var(--ui-menu) center/contain no-repeat;font-size:0;filter:drop-shadow(0 3px 2px #9b5a6e30)}#rightControls{position:absolute;right:20px;bottom:max(17px,env(safe-area-inset-bottom));display:flex;gap:12px;align-items:flex-end;pointer-events:auto;touch-action:none}#jump,#action{border:0;background-color:transparent;background-position:center;background-size:contain;background-repeat:no-repeat;filter:drop-shadow(0 4px 2px #8e4c6033);font-size:0;padding:0;touch-action:none}#jump{width:76px;height:84px;background-image:var(--ui-jump)}#action{width:94px;height:104px;background-image:var(--ui-action)}#stick{position:fixed;z-index:4;width:108px;height:108px;border:2px solid #fff8;border-radius:50%;background:#dab7c457;pointer-events:none}#nub{position:absolute;left:32px;top:32px;width:40px;height:40px;border-radius:50%;background:#fff7edcb;border:2px solid #d39baf;box-shadow:0 3px 8px #8e527744}#toast{position:fixed;z-index:50;top:18%;left:50%;transform:translateX(-50%);padding:10px 20px;border-radius:18px;background:#69435ae8;color:#fff8e9;opacity:0;pointer-events:none;transition:opacity .15s}#toast.show{opacity:1}#loading{position:fixed;inset:0;display:grid;place-content:center;background:#f7e9df;z-index:100;color:#9b5978;letter-spacing:.15em}#roomScene{position:fixed;inset:0;z-index:8;isolation:isolate;overflow:hidden}#roomBackground{position:absolute;inset:0;background-position:center;background-size:cover;z-index:-2;transform-origin:center}#roomScene::before{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#e5b3c422,transparent 65%);z-index:-1;pointer-events:none}#malePortrait,#femalePortrait{position:absolute;height:78%;width:32%;bottom:0;object-fit:contain;object-position:center bottom;transform-origin:center bottom;pointer-events:none;filter:drop-shadow(0 6px 10px #5033462b)}#malePortrait{left:3%;opacity:.4}#femalePortrait{right:3%}#femalePortrait.speaking{animation:bounceSpeak .33s ease-out}#malePortrait.speaking{animation:maleSpeak .3s ease-out}#roomName{position:absolute;top:17px;left:50%;transform:translateX(-50%);font-size:14px;background:#fff3e5c2;border-radius:20px;padding:6px 16px}#roomBack,#roomGear{position:absolute;top:10px;width:47px;height:47px;border:0;border-radius:50%;background:#fff4e8bf;font-size:27px;color:#91677d;z-index:5}#roomBack{left:10px}#roomGear{right:10px;font-size:0;background:var(--ui-gear) center/contain no-repeat;width:54px;height:59px}#dialoguePanel{position:absolute;left:27%;width:46%;bottom:17%;padding:30px 42px 24px;min-height:150px;max-height:36%;background:var(--ui-dialogue) center/100% 100% no-repeat;z-index:3;pointer-events:none;display:flex;flex-direction:column;justify-content:center}#speaker{font-size:12px;color:#b16d8e;margin-bottom:5px}#line{font-size:clamp(15px,1.65vw,23px);line-height:1.55;font-weight:650;word-break:keep-all}#startGame{position:absolute;left:50%;bottom:3%;transform:translateX(-50%);height:42px;width:146px;background:var(--ui-button) center/100% 100% no-repeat;border:0;color:#fff7ee;font-size:14px;font-weight:750;text-shadow:0 1px #9e5a79;z-index:5}#gameChoices{position:absolute;bottom:10%;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:4}#gameChoices button{border:0;background:#ffefdfc4;padding:5px 12px;border-radius:15px;font-size:11px;color:#93657c}#gameChoices button.selected{background:#b27396;color:#fff1df}#gameChoices:has(button:only-child){display:none}#resultBadge{position:absolute;top:17%;left:50%;transform:translateX(-50%);font-weight:700;color:#e2669d;font-size:25px;background:#fff6e7dd;border-radius:18px;padding:15px 25px;z-index:9}#miniLayer{position:fixed;inset:0;z-index:10;background:#f0e4da}#miniFrame{width:100%;height:100%;border:0}#miniBack{position:absolute;top:7px;right:7px;z-index:4;background:#fff1e3d9;border:0;border-radius:14px;width:42px;height:38px;color:#915a78;font-size:23px}dialog{border:0;border-radius:22px;box-shadow:0 15px 70px #6b3d6244;width:min(600px,94vw);max-height:87dvh;background:#fff4e5;padding:22px;color:#795169;overflow:auto}dialog::backdrop{background:#493c4f75;backdrop-filter:blur(4px)}dialog h2{margin:0 40px 14px 0;font-size:23px;font-weight:600}.close{float:right;width:34px;height:34px;border:0;border-radius:50%;background:#efcfda;color:#98637d;font-size:24px}.panel-list{display:grid;gap:10px}.panel-button{background:var(--ui-button) center/100% 100% no-repeat;border:0;min-height:49px;padding:10px 24px;color:#82536c;font-size:14px}.profile-tabs{display:flex;gap:5px;margin-bottom:8px}.profile-tabs button{flex:1;border:0;border-radius:12px;background:#efdae8;padding:10px;color:#915a78}.profile-tabs button.selected{background:#ba79a0;color:#fff3df}.stat-row{display:grid;grid-template-columns:74px 1fr 40px;align-items:center;gap:10px;font-size:14px;padding:8px}.stat-row progress{width:100%;accent-color:#d789ac}.stat-row b{text-align:right;font-size:13px}.inventory-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.inventory-grid button{aspect-ratio:1;border:2px solid #e9bd95;border-radius:10px;background:#f2d8c7;color:#81586d;font-size:12px}input{border:1px solid #debed0;padding:10px;border-radius:10px;background:#fffaf0;color:#795169;min-width:0}#studio{position:fixed;inset:0;z-index:60}.studio-shield{position:absolute;inset:0;touch-action:none}.studio-outline{position:fixed;border:2px dashed #df699e;box-shadow:0 0 0 1px #fff8;pointer-events:none}#studio aside{position:absolute;top:10px;bottom:10px;right:10px;width:220px;overflow:auto;background:#fff5e7ed;backdrop-filter:blur(12px);border-radius:18px;padding:13px;display:flex;flex-direction:column;gap:12px;box-shadow:0 8px 30px #66406244}#studio header{display:flex;align-items:center;justify-content:space-between}#studio button,#studio select{border:1px solid #e0b8c9;border-radius:9px;padding:8px;background:#fff5eb;color:#84536d;font-size:12px}#studio label{font-size:12px;display:grid;gap:4px}#studio input[type=range]{padding:0;width:100%;accent-color:#b77399}#studio input[type=file]{font-size:10px;width:100%;padding:4px}.studio-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px}#studio [data-a=save]{background:#b5799c;color:#fff4e8}#studioStatus{font-size:11px}#studio.preview .studio-shield,#studio.preview .studio-outline{display:none}#studio.preview aside{top:auto;bottom:8px;width:150px}#studio.preview aside>*:not(.studio-actions){display:none}@keyframes bounceSpeak{40%{margin-bottom:7px;filter:drop-shadow(0 5px 14px #ff9bc477)}100%{margin-bottom:0}}@keyframes maleSpeak{50%{opacity:.55}}
@media(orientation:portrait){#heroHUD{width:204px;height:78px}.avatar{width:68px;height:76px}.resource{gap:5px}.meter{height:17px}#wallet{right:72px;top:18px;font-size:12px}#location{top:92px;font-size:11px;left:14px;transform:none;background:#fff1e18c}#rightControls{right:12px;bottom:24px;gap:8px}#jump{width:64px;height:73px}#action{width:80px;height:89px}#malePortrait{left:22%;top:8%;bottom:auto;width:56%;height:33%;object-position:center bottom}#femalePortrait{left:20%;top:52%;right:auto;bottom:auto;width:60%;height:37%;object-position:center bottom}#dialoguePanel{left:5%;width:90%;bottom:auto;top:39%;min-height:110px;max-height:21%;padding:22px 27px 20px}#line{font-size:16px;line-height:1.48}#speaker{font-size:11px}#gameChoices{bottom:9%}#startGame{bottom:2%;height:43px;width:142px}#studio aside{width:185px;padding:10px;gap:9px}dialog{padding:18px}.stat-row{grid-template-columns:65px 1fr 36px;font-size:12px}}
@media(orientation:landscape) and (max-height:500px){#heroHUD{transform:scale(.85);transform-origin:top left}#dialoguePanel{padding:20px 28px;min-height:115px}#line{font-size:16px}#malePortrait,#femalePortrait{height:84%}#rightControls{bottom:12px}#jump{width:58px;height:64px}#action{width:73px;height:80px}}

/* Compact management; artwork keeps its native shape. */
dialog.compact-menu{width:min(420px,88vw);padding:15px}.compact-menu h2:empty{display:none}.compact-menu .panel-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.compact-menu .panel-button{background:#f1d8e2;border:1px solid #d4a5b9;border-radius:10px;min-height:39px;padding:8px 5px;font-size:12px;color:#72445f}.compact-menu .close{width:29px;height:29px;font-size:20px;margin-bottom:9px}#sceneBoardArt{position:absolute;width:min(90vw,72vh);height:min(90vw,72vh);left:50%;top:50%;margin-left:calc(min(90vw,72vh) / -2);margin-top:calc(min(90vw,72vh) / -2);object-fit:contain;pointer-events:none;z-index:0}#gameChoices{flex-wrap:wrap;justify-content:center;width:90%}

#startClose{position:absolute;left:calc(50% + 80px);bottom:3%;height:42px;width:42px;border:1px solid #e2b6c9;border-radius:50%;background:#fff1e5df;color:#975b7a;font-size:26px;z-index:5}@media(orientation:portrait){#startClose{bottom:2%;height:43px}}
</style><style>/* Portraits extend below the viewport; no frame or inner crop. */
#roomScene{overflow:hidden}
#roomScene .portrait-slot{position:absolute;width:40vw;height:85dvh;bottom:-10dvh;top:auto;transform-origin:center bottom;pointer-events:none;isolation:isolate}
#malePortraitSlot{left:0;right:auto}#femalePortraitSlot{right:0;left:auto}
#roomScene .portrait-window{position:absolute;inset:0;overflow:visible;border-radius:0}
#roomScene #malePortrait,#roomScene #femalePortrait{position:absolute;left:50%;right:auto;top:auto;bottom:0;width:auto;height:100%;max-width:none;margin:0;object-fit:contain;object-position:center bottom;translate:-50% 0;transform-origin:center bottom;filter:drop-shadow(0 3px 6px #50334622);animation:portraitIdle 4.2s ease-in-out infinite;will-change:transform}
#roomScene #malePortrait{opacity:.48;animation-delay:-1.2s}
#roomScene #malePortrait.speaking,#roomScene #femalePortrait.speaking{animation:portraitTalking 2s ease-in-out infinite}
#roomScene #malePortrait.speaking{opacity:.62}
#roomScene #dialoguePanel{left:auto;right:3%;top:3%;bottom:auto;width:43%;height:25%;min-height:0;max-height:none;padding:0;background:none;display:block;pointer-events:auto;z-index:4}
#roomScene.male-speaking #dialoguePanel{left:3%;right:auto}
#dialoguePanel .bubble-art{position:absolute;inset:0;background:var(--bubble-pink) center/100% 100% no-repeat;pointer-events:none}
#roomScene.male-speaking .bubble-art{background-image:var(--bubble-mint)}
#dialoguePanel .bubble-copy{position:absolute;left:15%;right:14%;top:35%;bottom:23%;display:flex;flex-direction:column;min-height:0}
#roomScene.male-speaking .bubble-copy{left:16%;right:17%;top:34%;bottom:27%}
#roomScene #speaker{flex:none;text-align:center;font-size:clamp(11px,1.1vw,15px);margin-bottom:3px;color:#9d5275}
#roomScene.male-speaking #speaker{color:#267b70}
#roomScene #line{display:block;flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;touch-action:pan-y;font-size:clamp(13px,1.5vw,20px);line-height:1.43;color:#644652;word-break:normal;overflow-wrap:anywhere;scrollbar-width:thin}
#roomScene.male-speaking #line{color:#315f57}
@keyframes portraitIdle{0%,100%{transform:scale(1.01) rotate(-.12deg)}50%{transform:translateY(-1px) scale(1.018) rotate(.12deg)}}
@keyframes portraitTalking{0%,100%{transform:scale(1.025) rotate(-.3deg)}50%{transform:translateY(-2px) scale(1.04) rotate(.3deg)}}
@media(orientation:portrait){
 #roomScene .portrait-slot{width:60vw;height:72dvh;bottom:-12dvh;top:auto}
 #malePortraitSlot{left:-9%;right:auto;height:89dvh!important;bottom:-17dvh!important;top:auto}
 #femalePortraitSlot{right:-5%;left:auto;bottom:-8dvh!important;top:auto}
 #roomScene #dialoguePanel{left:1%;right:auto;top:auto;bottom:18%;width:55%;height:25%}
 #roomScene.male-speaking #dialoguePanel{left:auto;right:1%;top:23%;bottom:auto;width:55%;height:25%}
 #roomScene #line{font-size:clamp(14px,2.9vw,19px);line-height:1.45}
 #roomScene #speaker{font-size:clamp(11px,2.1vw,15px)}
 #dialoguePanel .bubble-copy{left:15%;right:14%;top:35%;bottom:24%}
}
@media(prefers-reduced-motion:reduce){#roomScene .portrait-image{animation:none!important}}

/* 2026-10-19: common story speech-bubble alignment fix. No game/animation changes. */
#roomScene #dialoguePanel {width:45.15%;height:26.25%;}
#roomScene #dialoguePanel .bubble-copy {top:25%;bottom:29%;}
#roomScene.male-speaking #dialoguePanel .bubble-copy {top:24%;bottom:30%;}
@media (orientation:portrait) {
  #roomScene #dialoguePanel, #roomScene.male-speaking #dialoguePanel {width:57.75%;height:26.25%;}
}
</style><style>/* The road is reserved for destination icons and tablet-grip controls. */
#cityUI{position:absolute;inset:0;pointer-events:none;color:#775064}#cityUI[hidden]{display:none}
.city-road #jump::after,.city-road #action::after{position:absolute;left:0;right:0;bottom:1px;font:800 11px Gaia,system-ui;color:#fff7ea;text-shadow:0 1px 3px #6c374f;pointer-events:none}.city-road #jump::after{content:'점프'}.city-road #action::after{content:'이동'}.city-road #wallet{color:#fff7e9;text-shadow:0 1px 3px #494056}
.city-road #rightControls{inset:0!important;pointer-events:none;display:block}.city-road #jump,.city-road #action{position:absolute;bottom:max(14px,env(safe-area-inset-bottom));pointer-events:auto}.city-road #jump{left:max(18px,env(safe-area-inset-left));width:92px;height:102px}.city-road #action{right:max(18px,env(safe-area-inset-right));width:92px;height:102px;background-image:var(--ui-jump)}
.city-road #location{display:none}#cityRouteHead{position:absolute;top:98px;left:20px;right:20px;display:flex;gap:12px;align-items:center;justify-content:center;text-shadow:0 1px 3px #fff,0 0 8px #fff;font-size:14px}#cityClock{pointer-events:auto;border:0;padding:5px 15px;background:var(--ui-plate) center/100% 100% no-repeat;color:#775064;font:inherit;min-height:30px}#cityReturn{position:absolute;right:16px;top:130px;pointer-events:auto;border:0;background:var(--ui-button) center/100% 100% no-repeat;min-width:90px;min-height:39px;color:#775064;font-weight:700}#cityReturn[hidden]{display:none}
#cityDestinations{position:absolute;left:124px;right:124px;bottom:12px;display:flex;align-items:end;justify-content:safe center;gap:12px;overflow-x:auto;overflow-y:hidden;pointer-events:auto;padding:7px 3px 2px;scrollbar-width:thin;scrollbar-color:#edbad1 transparent;touch-action:pan-x;overscroll-behavior:contain}#cityDestinations[hidden]{display:none}.city-destination{display:flex;flex-direction:column;align-items:center;justify-content:end;flex:0 0 76px;min-width:0;padding:0;border:0;background:none;color:#fff5e9;text-shadow:0 1px 3px #252b3d,0 0 3px #252b3d;font:700 12px Gaia,system-ui;cursor:pointer;touch-action:pan-x}.city-destination img{width:68px;height:55px;object-fit:contain;filter:drop-shadow(0 2px 3px #0008);transition:transform .12s}.city-destination:active img{transform:scale(.9)}.city-destination.current img{filter:drop-shadow(0 0 5px #ffe9a5)}.city-destination span{white-space:nowrap;margin-top:2px}.city-destination small{font-size:10px;font-weight:400;white-space:nowrap;opacity:.95;margin-top:2px}#cityProgress{position:absolute;left:135px;right:135px;width:calc(100% - 270px);bottom:54px;height:9px;accent-color:#ed91b6;border:0;border-radius:6px;overflow:hidden}#cityProgress[hidden]{display:none}#cityNotice{position:absolute;left:50%;top:27%;transform:translate(-50%,10px);opacity:0;transition:opacity .15s,transform .15s;white-space:nowrap;font:800 clamp(18px,2.4vw,30px) Gaia,system-ui;color:#fff8e9;text-shadow:0 2px 3px #744957,0 0 5px #744957;pointer-events:none}#cityNotice.show{opacity:1;transform:translate(-50%,0)}
@media(orientation:portrait){#cityRouteHead{top:112px;left:10px;right:10px;font-size:12px;flex-wrap:wrap;gap:6px}.city-road #jump,.city-road #action{width:70px;height:78px;bottom:max(8px,env(safe-area-inset-bottom))}.city-road #jump{left:10px}.city-road #action{right:10px}#cityDestinations{left:10px;right:10px;bottom:86px;gap:12px;justify-content:flex-start}.city-destination{flex-basis:62px;font-size:10px}.city-destination img{height:43px;width:56px}.city-destination small{font-size:9px}#cityProgress{left:95px;right:95px;width:calc(100% - 190px);bottom:43px}#cityReturn{top:156px;right:10px;min-height:31px;font-size:11px}#cityNotice{top:31%;font-size:20px}}
</style><style>
/* Presentation fixes. Existing dialogue placement and game boards are retained. */
#location{display:none!important}.avatar::after{background-size:contain!important}.avatar{width:84px;height:84px}
#startGame{width:196px;height:44px;background-size:contain!important}
#cityClock{min-width:90px;height:32px;padding:3px 15px;background-size:contain}
#cityReturn{min-width:144px;background-size:contain}
#panel.lift-guide{width:min(460px,92vw);max-height:92dvh;padding:14px 18px;background:#fff7edfa;border-color:#d6b3bc;border-radius:16px}
#panel.lift-guide h2{font-size:16px;margin:2px 0 12px;text-align:center;color:#79536a}
#panel.lift-guide .panel-list{display:grid;grid-template-columns:1fr;gap:7px}
#panel.lift-guide .lift-floor{width:100%;aspect-ratio:16/3;min-height:0;height:auto;border:0;border-radius:0;background:var(--ui-button) center/contain no-repeat;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:8px 34px;color:#77495d;box-shadow:none;cursor:pointer}
#panel.lift-guide .lift-floor strong{font:700 13px Gaia,system-ui}#panel.lift-guide .lift-floor small{font:500 10px Gaia,system-ui;line-height:1.3;white-space:normal}
#panel.lift-guide .lift-floor.current-floor{filter:drop-shadow(0 0 3px #e686b5)}
@media(orientation:portrait){.avatar{width:72px;height:72px}#panel.lift-guide .lift-floor strong{font-size:12px}#panel.lift-guide .lift-floor small{font-size:9px}}
</style><style>/* Supplied simple jelly bubbles. Native image ratios, no portrait frame. */
#roomScene #dialoguePanel{width:min(43vw,620px,calc(32dvh * var(--bubble-ratio,2.12)));height:auto;aspect-ratio:var(--bubble-ratio,2.12);max-height:none;background:none;padding:0}
#roomScene #dialoguePanel[data-size=small]{width:min(30vw,370px,calc(32dvh * var(--bubble-ratio,1.41)))}
#roomScene #dialoguePanel .bubble-art{background-image:var(--active-bubble);background-size:100% 100%;background-position:center;background-repeat:no-repeat}
#roomScene #dialoguePanel .bubble-copy,#roomScene.male-speaking #dialoguePanel .bubble-copy{left:10%;right:10%;top:14%;bottom:25%}
#roomScene #speaker{text-align:left;font-size:clamp(11px,1vw,14px);margin:0 0 4px}
#roomScene #line{font-size:clamp(13px,1.4vw,19px);line-height:1.45}
#panel.wall-editor{width:min(400px,94vw);max-height:94dvh;overflow:auto}
#panel.wall-editor .panel-list{display:flex;flex-direction:column;gap:10px}
.wall-preview{height:148px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;background:transparent}
.wall-preview img{max-width:130px;max-height:146px;object-fit:contain;transform-origin:center}
.wall-slider{display:flex;align-items:center;gap:12px;font-size:13px}.wall-slider span{width:48px;flex:none}.wall-slider input{flex:1;min-width:0;accent-color:#d987a6;height:34px}
@media(orientation:portrait){#roomScene #dialoguePanel{width:min(77vw,560px,calc(29dvh * var(--bubble-ratio,2.12)));height:auto;max-height:none;left:1%;right:auto;bottom:19%;top:auto}#roomScene.male-speaking #dialoguePanel{width:min(77vw,560px,calc(29dvh * var(--bubble-ratio,2.12)));left:auto;right:1%;top:22%;bottom:auto}#roomScene #dialoguePanel[data-size=small]{width:min(58vw,360px,calc(29dvh * var(--bubble-ratio,1.41)))}#roomScene #line{font-size:clamp(13px,3.3vw,19px)}#roomScene #speaker{font-size:clamp(11px,2.8vw,15px)}}

#roomScene.male-speaking #dialoguePanel{height:auto;min-height:0;max-height:none;aspect-ratio:var(--bubble-ratio,2.12)}
</style><style>
#panel:not(.compact-menu) .panel-button{aspect-ratio:16/3;min-height:44px;height:auto!important;background-size:contain!important;background-repeat:no-repeat!important;background-color:transparent!important;box-shadow:none!important;padding:10px 36px!important}
#panel .close{position:relative;z-index:2}.compact-menu .panel-list{clear:both}
#corridorDecorTools{position:fixed;top:100px;right:8px;display:flex;gap:5px;z-index:20010;pointer-events:auto}#corridorDecorTools[hidden]{display:none}#corridorDecorTools button{border:0;background:var(--ui-button) center/contain no-repeat;color:#754e65;min-width:65px;height:42px;font:700 13px Gaia,system-ui;touch-action:manipulation}.decor-editing #rightControls,.decor-editing #heroHUD{pointer-events:none;opacity:.45}.decor-editing #stage{touch-action:none}
#cityHurtBubble{position:fixed;width:104px;aspect-ratio:1.4056;background-position:center;background-size:contain;background-repeat:no-repeat;display:grid;place-items:center;padding-bottom:12px;font:800 18px Gaia,system-ui;color:#9e5274;pointer-events:none;z-index:80}#cityHurtBubble[hidden]{display:none}
</style><style>/* Existing supplied UI plates and room art remain the visual language. */
#day{white-space:nowrap}#gold{font-variant-numeric:tabular-nums}.city-destination.locked{filter:grayscale(.85);opacity:.45;animation:none;cursor:default}.life-log{display:block;padding:7px 0;border-bottom:1px solid #c9afbd55}.panel-list>small{line-height:1.6;color:#805e72}.panel-button{min-height:50px}#gameChoices{gap:8px;max-height:30vh;overflow:auto}#gameChoices button{min-height:44px;touch-action:manipulation}#resultBadge{pointer-events:none}#panel .panel-list{gap:10px}#panel label input[type=range]{width:100%;min-height:44px}#roomName{max-width:65vw;overflow:hidden;text-overflow:ellipsis}
#roomScene #gameChoices:has(button){display:flex!important;flex-wrap:wrap;width:min(92vw,900px);bottom:12%;z-index:9}#roomScene #gameChoices button{font-size:13px;min-height:44px;padding:8px 18px;background:#fff0e5ee;box-shadow:0 2px 6px #51314b30}#roomScene #gameChoices button:disabled{opacity:.45}#roomScene #gameChoices button.selected{background:#b27396}
#roomScene #gameChoices button[data-life-service]{width:clamp(235px,24vw,270px);aspect-ratio:16/3;min-height:0;padding:0 17px;background:transparent var(--ui-button) center/100% 100% no-repeat;box-shadow:none;border:0;border-radius:0;color:#fff5e9;text-shadow:0 1px 2px #8b4b6d;font-weight:700}
#storyPeek{position:fixed;right:16px;top:92px;max-width:220px;padding:7px 12px;color:#694d65;background:#fff5ebda;border-radius:13px;font:600 13px Gaia,system-ui;pointer-events:none;z-index:31;border-right:3px solid #ed83b0}#storyPeek[hidden]{display:none}.quest-target{filter:drop-shadow(0 0 9px #ef7caf)!important}.city-destination.quest-target img{animation:quest-wiggle 1.8s ease-in-out infinite}.lift-floor.quest-target{background-color:#f8cee3!important;color:#8f305f!important;border:2px solid #ec81b1!important}@keyframes quest-wiggle{0%,75%,100%{transform:rotate(0)}80%{transform:rotate(-7deg)}90%{transform:rotate(7deg)}}
</style></head><body>
<canvas id="stage" aria-label="가이아 시티 이동 공간"></canvas>
<div id="fieldUI"><button id="heroHUD" aria-label="스탯 인벤토리 스킬"><span class="avatar"><img id="heroFace" alt="주인공"></span><span class="resource"><span class="meter"><i id="hpFill"></i><span>♥ <b id="hpValue"></b></span></span><span class="meter mp"><i id="mpFill"></i><span>M <b id="mpValue"></b></span></span></span></button><div id="wallet"><b id="gold"></b> G<small id="day"></small></div><span id="location"></span><button id="menu" aria-label="메뉴">메뉴</button><div id="rightControls"><button id="jump" aria-label="점프">점프</button><button id="action" aria-label="액션">액션</button></div></div>
<div id="stick" hidden><i id="nub"></i></div><section id="roomScene" hidden><div id="roomBackground"></div><div id="sceneBoardArt" hidden></div><button id="roomBack" aria-label="돌아가기">‹</button><b id="roomName"></b><button id="roomGear" aria-label="화면 편집">설정</button><div id="malePortraitSlot" class="portrait-slot"><div class="portrait-window"><img id="malePortrait" class="portrait-image" alt="남성 실루엣"></div></div><div id="femalePortraitSlot" class="portrait-slot"><div class="portrait-window"><img id="femalePortrait" class="portrait-image" alt="주인공"></div></div><div id="dialoguePanel"><div class="bubble-art" aria-hidden="true"></div><div class="bubble-copy"><b id="speaker"></b><span id="line"></span></div></div><div id="gameChoices"></div><button id="startGame">시작하기</button><button id="startClose" aria-label="방 닫기">×</button><span id="resultBadge" hidden></span></section>
<section id="miniLayer" hidden><iframe id="miniFrame" title="미니게임"></iframe><button id="miniBack" aria-label="방으로">‹</button></section><dialog id="panel"></dialog><input id="saveFile" hidden type="file" accept="application/json"><div id="toast" role="status"></div><div id="loading">GAIA CITY</div>
