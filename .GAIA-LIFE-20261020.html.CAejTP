dio/07.ogg": "data:audio/ogg;base64,", "미니게임/audio/02.ogg": "data:audio/ogg;base64,", "미니게임/audio/04.ogg": "data:audio/ogg;base64,", "미니게임/audio/03.ogg": "data:audio/ogg;base64,", "미니게임/audio/01.ogg": "data:audio/ogg;base64,", "미니게임/animals/10.webp": "data:image/webp;base64,", "미니게임/animals/13.webp": "data:image/webp;base64,", "미니게임/animals/02.webp": "data:image/png;base64,", "미니게임/animals/18.webp": "data:image/webp;base64,", "미니게임/animals/08.webp": "data:image/png;base64,", "미니게임/animals/14.webp": "data:image/webp;base64,", "미니게임/animals/04.webp": "data:image/png;base64,", "미니게임/animals/11.webp": "data:image/webp;base64,", "미니게임/animals/01.webp": "data:image/png;base64,", "미니게임/animals/07.webp": "data:image/png;base64,", "미니게임/animals/09.webp": "data:image/png;base64,", "미니게임/animals/12.webp": "data:image/webp;base64,", "미니게임/animals/16.webp": "data:image/webp;base64,", "미니게임/animals/17.webp": "data:image/webp;base64,", "미니게임/animals/03.webp": "data:image/png;base64,", "미니게임/animals/05.webp": "data:image/png;base64,", "미니게임/animals/06.webp": "data:image/png;base64,", "미니게임/animals/15.webp": "data:image/webp;base64,", "미니게임/poses/balance-hips.webp": "data:image/svg+xml;base64,", "미니게임/poses/balance-arms.webp": "data:image/svg+xml;base64,", "미니게임/poses/balance-legs.webp": "data:image/svg+xml;base64,"};const MINI_SOURCE={"main": "/* 방 행사와 터치 챌린지. 본편의 저장·아이템·대사 원문을 변경하지 않는다. */\nconst MG_TITLES=['움찔 찾기','소시지 합치기','아슬아슬 균형 잡기','백만 대 챌린지','뒤를 조심!!','물어와!'];\nconst mgAsset=(kind,i)=>assetUrl('미니게임',kind,String(i).padStart(2,'0')+'.webp');\nconst mgDetail=(kind,name)=>assetUrl('미니게임',kind,name+'.webp');\nconst MG_BOSS_FACES={calm:'face01',surprise:'face05',tear:'face09',cry:'face10',blush:'face13'};\nconst MG_IMAGES={animals:[],sausages:[],poses:{},portrait:{},actors:{},effects:[],behind:{},fetch:{},boss:{}};\nfunction mgState(){return S.minigames||(S.minigames={version:1,next:S.t+.12,offer:null,history:[],plays:0});}\nfunction mgEligible(){const out=[];for(const b of ['center','office','home'])for(let i=0;i\u003cS[b].length;i++){if(b==='center'&&!S.center[i])continue;const ms=inRoom(S,b,i).filter(m=>m.hp>=25);if(ms.length)out.push({b,i,members:ms.map(m=>m.id)});}return out;}\nfunction mgOffer(){if(S.campaign&&S.campaign.phase!=='day')return null;const st=mgState();if(st.offer&&(!mgEligible().some(r=>r.b===st.offer.b&&r.i===st.offer.i)||S.t>st.offer.until))st.offer=null;if(!st.offer&&S.t>=st.next){const rooms=mgEligible();if(rooms.length){const r=pick(rooms),last=st.lastKind;let kinds=MG_TITLES.map((_,i)=>i).filter(k=>k!==last);st.offer={...r,kind:pick(kinds),until:S.t+.5};st.lastKind=st.offer.kind;st.next=S.t+.45+Math.random()*.25;save();}}return st.offer;}\nfunction mgRoomName(r){if(r.boss)return '송사장 특별 관리';return r.b==='center'?ROOMS[S.center[r.i]].name:TITLE[r.b]+' · '+stem(S[r.b][r.i].img);}\nfunction mgRoomBG(r){if(r.boss)return bgUrl('사무실','개인사무실.png');return bgUrl(FOLDER[r.b],r.b==='center'?ROOMS[S.center[r.i]].bg:S[r.b][r.i].img);}\nfunction mgReward(round,ratio){if(round.paid)return null;round.paid=true;const st=mgState();let totals=0,count=0;for(const id of round.members){const m=mById(id);if(!m)continue;count++;if(ratio\u003c.15)continue;let keys=round.b==='center'?Object.keys((ROOMS[S.center[round.i]]||{}).train||{}):Object.keys(wfx(S,round.b,round.i).up||{});if(!keys.length){m.hp=Math.min(100,m.hp+Math.round(6+ratio*12));continue;}const bonus=Math.round(2+ratio*6);for(const k of keys){const add=Math.min(bonus*(m.named?.5:1),100-m.st[k]);m.st[k]+=add;totals+=add;}m.trained=true;}\nconst tip=typeof campaignRecordGame==='function'?campaignRecordGame(round,ratio):0;S.rep+=totals*K.repPerPt;st.plays++;st.history.unshift({title:MG_TITLES[round.kind],room:round.name,score:Math.round(ratio*100),day:S.day});st.history=st.history.slice(0,12);save();updateHud();return {count,tip,bonus:ratio\u003c.15?0:Math.round(2+ratio*6),recovery:round.b==='center'&&!ROOMS[S.center[round.i]]?.train};}\nconst mgStyle=document.createElement('style');\nmgStyle.textContent=`#mgDialog{width:min(1400px,98vw);height:min(850px,94dvh);max-height:94dvh;padding:0;border:3px solid #fff3d9;border-radius:22px;overflow:hidden;background:#fff8e8;box-shadow:0 20px 80px #162c3677}#mgDialog::backdrop{background:#213739b8;backdrop-filter:blur(2px)}\n.mg-head{height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;background:#fff8e8;gap:10px}.mg-head h2{font-size:19px;margin:0}.mg-head button{background:#e3eadb;border-radius:12px;width:38px;height:38px;font-size:24px;flex:none}\n.mg-scene{position:relative;height:calc(100% - 52px);padding:14px;background-size:cover;background-position:center;display:grid;grid-template-columns:minmax(0,1fr) clamp(160px,19vw,260px);gap:14px;overflow:hidden;isolation:isolate}.mg-board{position:relative;display:flex;flex-direction:column;min-width:0;min-height:0;padding:12px;border:2px solid #fff9;border-radius:20px;background:#fff6eeb3;overflow:hidden}.mg-board.mg-room-stage{background:#fff7e93d;backdrop-filter:none;border-color:#fff6}.mg-stats{display:flex;align-items:center;justify-content:space-between;gap:8px;flex:none;min-height:34px;font-size:17px;font-weight:800;z-index:4;color:#3d5b59;text-shadow:0 1px #fff}.mg-instructions{margin:0;padding:8px;line-height:1.65;text-align:center;max-width:620px;align-self:center;font-size:16px}.mg-start{background:linear-gradient(#628e7c,#3e7463);color:white;border-radius:16px;padding:13px 22px;font-size:21px;font-weight:800;box-shadow:0 4px #2e5c4b;min-height:50px;border:1px solid #ffffff80}.mg-start:disabled{opacity:.45}.mg-small{font-size:12px;line-height:1.6;color:#516c60;text-align:center;margin:8px 0 0;flex:none;text-shadow:0 1px #fff}\n.mg-side{display:flex;flex-direction:column;justify-content:flex-end;align-items:center;position:relative;min-height:0;z-index:3}.mg-speech{width:100%;background:#fffbedf2;border:2px solid #e3cda9;border-radius:18px;padding:12px 14px;line-height:1.6;min-height:92px;box-shadow:0 4px 0 #0001;font-size:15px;position:relative;z-index:4}.mg-speech strong{display:block;color:#718b79;font-size:12px;margin-bottom:6px}.mg-portrait{position:relative;width:100%;height:min(68%,430px);min-height:140px;display:flex;align-items:flex-end;justify-content:center;isolation:isolate;transform-origin:50% 85%}.mg-portrait .mg-face{position:static;display:block;width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 5px 5px #282d3222)}.mg-portrait.mg-boss-portrait{height:min(45%,250px);min-height:100px;margin-top:12px}.mg-body{display:none}.mg-sweat{position:absolute;top:28%;left:68%;width:10px;height:18px;border-radius:75% 20% 70% 70%;background:#85d7f1;border:1px solid white;z-index:4;pointer-events:none;animation:mgSweat .6s forwards}\n.mg-preview{display:flex;align-items:center;justify-content:center;gap:12px;flex:1;min-height:80px;overflow:hidden}.mg-preview img{object-fit:contain;max-width:28%;max-height:90%;filter:drop-shadow(0 9px 6px #0002)}.mg-preview.balance-preview img{max-width:80%;width:80%;height:100%}.mg-difficulty{display:flex;gap:8px;justify-content:center;flex:none;margin:8px 0 14px}.mg-difficulty button{padding:10px 16px;background:#fff7eb;border:2px solid #c4d4bd;border-radius:13px;font-weight:700}.mg-difficulty button.active{background:#548476;border-color:#548476;color:white}.mg-preview.sausage-preview{align-items:center}.mg-preview.sausage-preview img{transform:rotate(90deg);width:110px;height:50px;max-width:25%;margin:30px 10px}\n.mg-animal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:8px;flex:1;min-height:0;width:100%;margin:8px auto}.mg-animal{position:relative;min-height:0;width:100%;height:100%;background:radial-gradient(ellipse at 50% 85%,#7e9c7e66,transparent 65%);border:0;touch-action:manipulation;overflow:visible}.mg-animal .animal-sprite{width:100%;height:100%;object-fit:cover;pointer-events:none;transform-origin:50% 85%}.mg-animal.wiggle .animal-sprite{animation:mgWiggle .22s infinite}.mg-animal.hit .animal-sprite{animation:mgSquash .32s}.mg-animal.wrong .animal-sprite{animation:mgWrong .3s}.mg-progress{height:9px;flex:none;border-radius:8px;background:#d9e5d0;overflow:hidden}.mg-progress i{display:block;height:100%;background:#80b79c}.mg-fx{position:absolute;inset:0;display:grid;place-items:center;font-weight:900;font-size:32px;color:#fff1a4;text-shadow:2px 2px #7e3f44;pointer-events:none;z-index:3}.mg-paddle{position:absolute;width:90px!important;height:95px!important;right:0;top:0;object-fit:contain;z-index:4;animation:mgPaddle .26s;transform-origin:85% 20%;pointer-events:none}\n.mg-canvas-wrap{flex:1;min-height:0;min-width:0;position:relative;overflow:hidden}.mg-canvas{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:contain;touch-action:none;background:transparent}.mg-controls{display:flex;justify-content:center;gap:16px;flex:none;padding-top:8px}.mg-controls button{background:#4f7f70;color:#fff;border-radius:14px;min-width:130px;min-height:49px;font-size:20px;touch-action:none;box-shadow:0 3px #30584b}.mg-controls button:active{transform:translateY(2px)}.mg-next{display:flex;align-items:center;gap:13px;font-size:13px;padding:0 10px;flex:none;justify-content:center;min-height:67px}.mg-next img{height:32px;width:82px;object-fit:contain;transform:rotate(90deg);margin:18px 10px}.mg-food-rail{display:flex;gap:6px;justify-content:center;align-items:center}.mg-food-rail img{width:44px;height:30px;object-fit:contain}.mg-food-rail span{display:grid;justify-items:center;font-size:10px;color:#738978}.mg-next strong{color:#a35762;font-size:16px}\n/* The room is the stage. No cards around the three full-size actors. */\n.mg-tap-stage{flex:1;min-height:0;position:relative;isolation:isolate}.mg-tap-person{position:absolute;width:49%;height:47%;padding:0;border:0;background:none;text-align:center;transform-origin:60% 90%;filter:drop-shadow(0 8px 4px #26372828)}.mg-tap-person:nth-child(1){left:0;top:3%}.mg-tap-person:nth-child(2){right:0;top:3%}.mg-tap-person:nth-child(3){left:23%;bottom:1%;width:55%;height:49%}.mg-tap-person::after{content:'';position:absolute;left:7%;right:5%;bottom:5%;height:15%;background:radial-gradient(ellipse,var(--mat),transparent 70%);opacity:.3;z-index:-1}.mg-tap-target{position:absolute;inset:0;width:100%;height:100%;border:0;background:transparent;padding:20px 0 0;touch-action:none;overflow:visible}.mg-tap-target .mg-actor-sprite{width:100%;height:100%;object-fit:contain;object-position:center bottom;pointer-events:none;transform-origin:65% 85%}.mg-head-meter{position:absolute;left:3%;top:7%;width:37%;z-index:8;pointer-events:none;filter:drop-shadow(0 2px 2px #0003)}.mg-head-meter strong{display:inline-block;color:#fff;background:var(--mat);font-size:12px;border-radius:20px;padding:3px 10px;margin-bottom:3px;text-shadow:0 1px #0002}.mg-tap-gauge{height:14px;background:#e7e8d4e6;border:2px solid #fff;border-radius:15px;overflow:hidden}.mg-tap-gauge i{display:block;height:100%;background:var(--mat);border-radius:15px}.mg-tap-value{display:block;font-size:10px;font-weight:700;color:#405a53;margin-top:2px;text-shadow:0 1px white}.mg-tap-person.danger .mg-tap-gauge{animation:mgDanger .35s infinite alternate}.mg-tap-label{display:none}.mg-tap-paddle{position:absolute;right:10%;top:4%;width:125px;height:125px;object-fit:contain;pointer-events:none;animation:mgPaddle .24s;transform-origin:80% 15%;z-index:7}\n.mg-fx-layer{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:20}.mg-effect-art{position:absolute;object-fit:contain;transform:translate(-50%,-50%);animation:mgArt .65s forwards;filter:drop-shadow(0 3px 2px #0002);pointer-events:none}.mg-heart{position:absolute;color:var(--pink);font-size:var(--size);font-family:Arial,sans-serif;text-shadow:0 2px #fff,2px 0 #fff,-2px 0 #fff;transform:translate(-50%,-50%);animation:mgHeart var(--life) cubic-bezier(.15,.6,.3,1) forwards;pointer-events:none}.mg-flash{position:absolute;inset:0;background:radial-gradient(ellipse,#fff5ec66,#ff4b9e33);animation:mgFlash .25s forwards;pointer-events:none}.mg-result{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:14px;flex:1;padding:15px;position:relative;z-index:4}.mg-result h3{font-size:28px;margin:0;color:#487666}.mg-result b{font-size:52px;color:#b76c82}.mg-result p{margin:0;line-height:1.6}.mg-badge{position:absolute;top:6px;left:6px;background:#fff4ae;color:#614932;font-weight:700;border-radius:12px;padding:5px 8px;font-size:12px;z-index:5;box-shadow:0 2px 5px #0002;animation:mgBadge 1.5s infinite}\n@keyframes mgSweat{to{transform:translateY(60px);opacity:0}}@keyframes mgWiggle{0%,100%{transform:rotate(-5deg) translateX(-4px)}50%{transform:rotate(5deg) translateX(4px)}}@keyframes mgSquash{25%{transform:translateY(6px) scale(1.22,.7)}60%{transform:translateY(-10px) scale(.94,1.1)}}@keyframes mgWrong{30%{transform:translateX(-6px)}70%{transform:translateX(6px)}}@keyframes mgPaddle{0%{transform:rotate(-65deg) translateY(-25px) scale(1.2)}50%{transform:rotate(20deg) translateY(8px)}100%{transform:rotate(-30deg) translateY(-20px);opacity:0}}@keyframes mgDanger{to{border-color:#ed6f82;box-shadow:0 0 15px #e95d77}}@keyframes mgBadge{50%{box-shadow:0 0 0 4px #ffce6655}}@keyframes mgFlash{to{opacity:0}}@keyframes mgArt{0%{opacity:0;transform:translate(-50%,-50%) scale(.2) rotate(-13deg)}20%{opacity:1;transform:translate(-50%,-50%) scale(1.17) rotate(5deg)}65%{opacity:1}100%{opacity:0;transform:translate(-50%,-65%) scale(1.06) rotate(-3deg)}}@keyframes mgHeart{0%{opacity:0;transform:translate(-50%,-50%) scale(.1)}15%{opacity:.95}100%{opacity:0;transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(1.3) rotate(var(--spin))}}\n@media(max-height:600px){.mg-head{height:44px}.mg-scene{height:calc(100% - 44px);padding:8px;gap:8px;grid-template-columns:minmax(0,1fr) 165px}.mg-board{padding:8px}.mg-speech{font-size:13px;padding:9px;min-height:74px}.mg-portrait{height:65%;min-height:130px}.mg-stats{font-size:14px;min-height:28px}.mg-small{font-size:10px;margin-top:4px}.mg-controls button{min-height:40px}.mg-next{min-height:56px}.mg-start{min-height:44px;padding:9px 20px}.mg-instructions{font-size:14px}.mg-difficulty button{padding:7px 12px}.mg-result{gap:8px}.mg-result b{font-size:38px}}\n@media(max-width:650px) and (orientation:portrait){#mgDialog{height:94dvh;width:98vw;border-width:2px}.mg-head h2{font-size:16px}.mg-head{padding:0 10px}.mg-scene{display:block;padding:8px}.mg-board{height:100%;padding:10px}.mg-side{position:absolute;right:8px;bottom:15px;width:30%;height:35%;pointer-events:none}.mg-speech{font-size:11px;padding:8px;min-height:55px;line-height:1.5}.mg-speech strong{font-size:10px;margin-bottom:2px}.mg-portrait{height:72%;min-height:0}.mg-tap-stage{margin-bottom:100px}.mg-tap-person{width:55%;height:43%}.mg-tap-person:nth-child(1){left:0;top:7%}.mg-tap-person:nth-child(2){right:0;top:30%}.mg-tap-person:nth-child(3){left:0;bottom:0;width:60%;height:43%}.mg-head-meter{width:48%;top:0}.mg-instructions{font-size:14px}.mg-animal-grid{padding-bottom:140px}.mg-canvas-wrap{margin-bottom:80px}.mg-result{padding-bottom:160px}.mg-preview{padding-bottom:100px}.mg-preview.balance-preview img{width:95%;max-width:95%}.mg-difficulty{justify-content:flex-start}.mg-difficulty button{font-size:12px;padding:8px}.mg-controls{justify-content:flex-start}.mg-controls button{min-width:95px}.mg-next{justify-content:flex-start;font-size:11px}}\n/* Keep animal targets and dialogue in separate areas on narrow screens. */\n@media(max-width:650px) and (orientation:portrait){.mg-scene.mg-animal-scene{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(0,1fr) clamp(120px,23%,170px);gap:8px}.mg-animal-scene .mg-side{position:relative;inset:auto;width:100%;height:100%;flex-direction:row;gap:12px;padding:0 10px;align-items:center}.mg-animal-scene .mg-speech{width:auto;flex:1;min-width:0}.mg-animal-scene .mg-portrait{width:26%;height:100%;flex:none}.mg-animal-scene .mg-animal-grid,.mg-animal-scene .mg-preview,.mg-animal-scene .mg-result{padding-bottom:0}}\n\n/* Wide-only wiggle game: 3×3 square at maximum height; HUD sits beside it, not over targets. */\n@media (orientation:landscape) and (min-width:700px){\n .mg-scene.mg-wiggle-landscape{grid-template-columns:minmax(0,2fr) minmax(176px,1fr);align-items:center;gap:12px}\n .mg-wiggle-landscape .mg-board.mg-wiggle-square{display:grid;place-items:center;box-sizing:border-box;width:min(100%,calc(100dvh - 90px));height:auto;aspect-ratio:1 / 1;max-height:100%;padding:6px;align-self:center;justify-self:end}\n .mg-wiggle-landscape .mg-board .mg-animal-grid{box-sizing:border-box;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));width:100%;height:auto;aspect-ratio:1 / 1;min-height:0;max-height:100%;flex:none;margin:0;gap:6px}\n .mg-wiggle-landscape .mg-animal{min-width:0;min-height:0}\n .mg-wiggle-landscape .mg-animal .animal-sprite{display:block;width:100%;height:100%;object-fit:cover}\n .mg-wiggle-landscape .mg-side{width:100%;height:100%;justify-content:flex-end;align-items:stretch}\n .mg-wiggle-landscape .mg-wiggle-stats{position:absolute;top:3px;left:0;right:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;padding:10px 6px;min-height:64px;border-radius:14px;background:#fff9e9eb;box-shadow:0 3px 8px #33292220;text-align:center;line-height:1.2}\n .mg-wiggle-landscape .mg-wiggle-stats strong{min-width:0;font-size:clamp(13px,1.6vw,23px);white-space:nowrap;color:#466e63}\n .mg-wiggle-landscape .mg-wiggle-progress{position:absolute;top:77px;left:2%;width:96%;height:10px;margin:0;border-radius:10px}\n .mg-wiggle-landscape .mg-side .mg-portrait{height:min(44%,260px);min-height:70px}\n .mg-wiggle-landscape .mg-side .mg-speech{min-height:70px}\n}\n\n`;\ndocument.head.append(mgStyle);\nconst mgDialog=document.createElement('dialog');mgDialog.id='mgDialog';document.body.append(mgDialog);\nlet mgRound=null,mgCleanup=()=>{};\nfunction mgClose(){mgStopVoice();mgCleanup();mgCleanup=()=>{};mgClearFX();mgDialog.close();}\nmgDialog.addEventListener('cancel',()=>{mgStopVoice();mgCleanup();mgCleanup=()=>{};mgClearFX();});\nmgDialog.addEventListener('close',()=>{if(mgDialog.open)return;mgStopVoice();mgClearFX();mgCleanup();mgCleanup=()=>{};const closedRound=mgRound;mgRound=null;last=Date.now();render();mgBadges();if(typeof campaignAfterGameClose==='function')campaignAfterGameClose(closedRound);});\nfunction mgFace(face='blush'){\n const el=mgDialog.querySelector('.mg-face');const named=mgRound?.named;if(named&&typeof namedAsset==='function'){el.src=namedAsset(named,'face');el.dataset.face=face;el.style.filter=face==='blush'?'drop-shadow(0 0 10px #ff9cb5)':'';return;}const actors=mgRound?.boss?MG_IMAGES.boss:MG_IMAGES.actors;if(el&&actors[face]){el.src=actors[face].src;el.dataset.face=face;}\n}\nfunction mgSay(text,face=4){const el=mgDialog.querySelector('.mg-line');if(el)el.textContent=text;mgFace(typeof face==='string'?face:({1:'blush',3:'surprise',4:'blush',5:'tear'})[face]||'blush');}\nconst mgAudioUrl=i=>assetUrl('미니게임','audio',String(i).padStart(2,'0')+'.ogg');\nconst MG_VOICES=[];let mgVoiceActive=null,mgVoiceAt=-10000,mgHeartAt=-10000;\nfunction mgAudioUnlock(){if(!MG_VOICES.length)for(let i=1;i\u003c=7;i++){const a=new Audio(mgAudioUrl(i));a.preload='auto';a.volume=.6;MG_VOICES.push(a);}try{if(AC?.state==='suspended')AC.resume();}catch{}}\nfunction mgStopVoice(){MG_VOICES.forEach(a=>{a.pause();a.currentTime=0;});mgVoiceActive=null;}\nfunction mgVoice(force=false){if(!S.cfg.sound||document.hidden||!MG_VOICES.length)return;const now=performance.now();if(now-mgVoiceAt\u003c720||(!force&&Math.random()>.32))return;if(mgVoiceActive&&!mgVoiceActive.ended)return;const a=pick(MG_VOICES);a.currentTime=0;mgVoiceActive=a;mgVoiceAt=now;a.play().catch(()=>{if(mgVoiceActive===a)mgVoiceActive=null;});}\ndocument.addEventListener('visibilitychange',()=>{if(document.hidden)mgStopVoice();});\nfunction mgClearFX(){const layer=mgDialog.querySelector('.mg-fx-layer');if(layer)layer.replaceChildren();}\nfunction mgEffect(n,x=50,y=45,size=220){const layer=mgDialog.querySelector('.mg-fx-layer'),im=MG_IMAGES.effects[n-1];if(!layer||!im)return;if(layer.querySelectorAll('.mg-effect-art').length>5)return;const fx=mgNode('img','mg-effect-art',undefined,layer);fx.src=im.src;fx.alt='';fx.style.cssText=`left:${x}%;top:${y}%;width:min(${size}px,42vw);height:min(${size}px,42vw)`;setTimeout(()=>fx.remove(),680);}\nfunction mgHearts(x=50,y=50,count=24){const layer=mgDialog.querySelector('.mg-fx-layer');if(!layer)return;const now=performance.now();if(now-mgHeartAt\u003c260&&count\u003c35)return;mgHeartAt=now;const existing=layer.querySelectorAll('.mg-heart').length,countSafe=Math.min(count,90-existing);for(let i=0;i\u003ccountSafe;i++){const h=mgNode('span','mg-heart','♥',layer),angle=Math.random()*Math.PI*2,dist=140+Math.random()*360;h.style.cssText=`left:${x}%;top:${y}%;--size:${28+Math.random()*60}px;--pink:${pick(['#ff69ad','#ff98ca','#ed367f','#ffc0db'])};--dx:${Math.cos(angle)*dist}px;--dy:${Math.sin(angle)*dist-60}px;--spin:${Math.random()*90-45}deg;--life:${.7+Math.random()*.5}s`;setTimeout(()=>h.remove(),1250);}if(count>=30){const fl=mgNode('div','mg-flash',undefined,layer);setTimeout(()=>fl.remove(),260);mgEffect(23,x,y,260);}}\nfunction mgReact(face='surprise',power=1){mgFace(face);const frame=mgDialog.querySelector('.mg-portrait');if(frame){frame.getAnimations().forEach(a=>a.cancel());frame.animate([{transform:'translateY(0)'},{transform:`translateY(-${9+power*3}px) rotate(-3deg)`},{transform:'translateY(3px) rotate(2deg)'},{transform:'none'}],{duration:280});for(let i=0;i\u003c3;i++){const d=mgNode('span','mg-sweat','',frame);d.style.left=(62+Math.random()*18)+'%';d.style.animationDelay=i*.04+'s';setTimeout(()=>d.remove(),800);}}mgVoice();}\nfunction mgImpact(text='찰싹!!',power=1){const board=mgDialog.querySelector('.mg-board');if(!board)return;if(mgRound?.kind!==0)board.animate([{transform:'translate(0)'},{transform:`translate(${-3*power}px,${power}px)`},{transform:`translate(${3*power}px,${-power}px)`},{transform:'none'}],{duration:180});const n=text.includes('와장')?6:text.includes('뽕')?10:1;mgEffect(n,35+Math.random()*30,30+Math.random()*30,180+power*30);mgHearts(50,55,power>=3?38:22);}\nfunction mgNode(tag,cls,text,parent){const e=document.createElement(tag);if(cls)e.className=cls;if(text!==undefined)e.textContent=text;if(parent)parent.append(e);return e;}\nfunction mgButton(text,fn,parent){const b=mgNode('button','mg-start',text,parent);b.onclick=fn;return b;}\nasync function mgLoad(){\n const jobs=[];const load=(group,key,src)=>{if(MG_IMAGES[group][key])return;jobs.push(new Promise(resolve=>{const im=new Image();im.onload=()=>{MG_IMAGES[group][key]=im;resolve();};im.onerror=()=>resolve();im.src=src;}));};\n for(const [kind,n] of [['animals',9],['sausages',6]])for(let i=1;i\u003c=n;i++)load(kind,i-1,mgAsset(kind,i));\n for(const name of ['arms','back','hips','prone','bench','plank','tap1','tap2','tap3','balance-hips','balance-arms','balance-legs'])load('poses',name,mgDetail('poses',name));\n for(const name of ['body','surprise','tear','cry','blush'])load('portrait',name,mgDetail('portrait',name));\n for(const name of ['surprise','tear','cry','blush','calm'])load('actors',name,mgDetail('actors',name));\n for(let i=1;i\u003c=24;i++)load('effects',i-1,mgAsset('effects',i));\n for(const name of [...Array.from({length:9},(_,i)=>'rear'+(i+1)),...Array.from({length:11},(_,i)=>'crawl'+(i+1)),...Array.from({length:3},(_,i)=>'fly'+(i+1)),'ball','duck','slipper'])load('behind',name,mgDetail('behind',name));\n for(const name of ['run1','run2','run3','run4','jump1','jump2','jump3','jump4','floor','floor-mirror',...(window.HERO_MOTION?['crawl-sheet','jump-sheet']:[])])load('fetch',name,mgDetail('fetch',name));\n for(const name of ['cat','blind','cuffs'])load('fetch',name,itemUrl('상품',name));\n for(const [name,file] of Object.entries(MG_BOSS_FACES))load('boss',name,campaignAsset('boss',file+'.webp'));\n await Promise.all(jobs);\n}\nfunction openMiniGame(offer,practice=false){\n  if(mgDialog.open)return;\n  mgCleanup();mgCleanup=()=>{};\n  stopScene();stopDlgActors();if(dlg.open)dlg.close();if(tdlg.open)tdlg.close();\n  const ms=offer.boss?[campaignBoss()]:offer.members.map(mById).filter(Boolean);if(!ms.length)return toast('참가할 회원이 없습니다.');\n  mgRound={...offer,members:ms.map(m=>m.id),name:mgRoomName(offer),set:offer.b==='office'?'회사':offer.b==='home'?'집':'센터',paid:false,practice};\n  if(!practice){const st=mgState();st.offer=null;st.next=Math.max(st.next,S.t+.3);save();}\n  mgDialog.replaceChildren();const head=mgNode('div','mg-head',undefined,mgDialog);mgNode('h2','',MG_TITLES[offer.kind]+' · '+mgRound.name,head);const close=mgNode('button','','×',head);close.setAttribute('aria-label','미니게임 닫기');close.onclick=mgClose;\n  const scene=mgNode('div','mg-scene',undefined,mgDialog);scene.classList.toggle('mg-animal-scene',offer.kind===0||offer.kind===4);scene.classList.toggle('mg-behind-scene',offer.kind===4);scene.classList.toggle('mg-fetch-scene',offer.kind===5);scene.classList.toggle('mg-animal-scene',offer.kind===0||offer.kind===4||offer.kind===5);scene.style.backgroundImage=`url(\"${mgRoomBG(offer)}\")`;const board=mgNode('div','mg-board',undefined,scene);mgNode('div','mg-fx-layer',undefined,scene);const side=mgNode('aside','mg-side',undefined,scene),speech=mgNode('div','mg-speech',undefined,side);mgNode('strong','',nameOf(ms[0])+(ms.length>1?` 외 ${ms.length-1}명`:''),speech);mgNode('span','mg-line','오늘은 어떤 훈련인가요, 조교님?',speech);const frame=mgNode('div','mg-portrait',undefined,side);const im=mgNode('img','mg-face',undefined,frame);frame.classList.toggle('mg-boss-portrait',!!offer.boss);im.src=offer.boss?campaignAsset('boss',MG_BOSS_FACES.calm+'.webp'):mgDetail('actors','calm');if(ms[0].named){mgRound.named=ms[0].named;im.src=namedAsset(ms[0].named,'face');frame.classList.add('mg-boss-portrait');}im.alt='참가 회원 표정';im.dataset.face='calm';\n  mgNode('p','mg-instructions',['움찔하는 동물을 찾아 눌러 주세요! 25초 동안 정확하게, 연속으로!','같은 소시지 두 개를 합쳐 보세요. 위치를 골라 놓으면 통통! 60초 점수전입니다.','팔·등·엉덩이 중 난이도를 고르고 컵 균형을 잡아 주세요. 25초 동안 컵 세 개를 지켜 주세요!','세 사람을 번갈아 연타해 게이지를 유지하세요. 한 명이라도 바닥나면 종료! 기록은 버틴 시간입니다.','아래 소품을 아래로 당겼다 놓으세요! 좌우로 피하는 캐릭터를 맞히는 30초 점수전. 소품마다 날아가는 성질이 다릅니다.','전진을 연타하고 장애물 앞에서는 점프! 멀리 던진 물건을 회수해 주세요.'][offer.kind],board);\n  const preview=mgNode('div','mg-preview',undefined,board);const start=mgButton('그림 준비 중…',()=>{},board);start.disabled=true;mgNode('p','mg-small',offer.boss?'송사장님의 야근 예약 · 한 판 후 아침으로':practice?'연습 경기 · 성장 보상 없음':`발생 당시 참가 회원 ${ms.length}명에게 성적에 따른 보너스 · 경기 중 본편 일시정지`,board);\n  mgDialog.showModal();mgLoad().then(()=>{\n if(!mgDialog.open||!start.isConnected)return;\n function previewImages(images){preview.replaceChildren();images.forEach(im=>{if(im){const p=mgNode('img','',undefined,preview);p.src=im.src;}});}\n if(offer.kind===2){\n  preview.classList.add('balance-preview');mgRound.difficulty=0;\n  const levels=mgNode('div','mg-difficulty',undefined,board);levels.setAttribute('aria-label','균형 잡기 난이도');board.insertBefore(levels,start);\n  const drawLevel=level=>{mgRound.difficulty=level;previewImages([MG_IMAGES.poses[['balance-hips','balance-arms','balance-legs'][level]]]);Array.from(levels.children).forEach((b,i)=>{b.classList.toggle('active',i===level);b.setAttribute('aria-pressed',String(i===level));});};\n  ['쉬움 · 엉덩이','보통 · 팔','어려움 · 다리'].forEach((t,i)=>{const b=mgNode('button','',t,levels);b.onclick=()=>drawLevel(i);});drawLevel(0);\n }else if(offer.kind===3)previewImages(['tap1','tap2','tap3'].map(n=>MG_IMAGES.poses[n]));\n else if(offer.kind===1){preview.classList.add('sausage-preview');previewImages([0,2,5].map(i=>MG_IMAGES.sausages[i]));}\n else if(offer.kind===5){preview.classList.add('balance-preview');previewImages([MG_IMAGES.fetch.run1]);}\n else if(offer.kind===4){preview.classList.add('behind-preview');previewImages([MG_IMAGES.behind.crawl1]);}\n else previewImages([0,3,8].map(i=>MG_IMAGES.animals[i]));\n start.disabled=false;start.textContent='시작!';start.onclick=()=>{mgAudioUnlock();board.replaceChildren();board.classList.toggle('mg-room-stage',offer.kind===2||offer.kind===3||offer.kind===4);if(offer.kind===0)mgWiggle(board);else if(offer.kind===1)mgMerge(board);else if(offer.kind===2)mgBalance(board);else if(offer.kind===3)mgTap(board);else if(offer.kind===4)mgBehind(board);else mgFetch(board);};\n});\n}\nfunction mgFinish(score,ratio,message){\n  mgStopVoice();mgCleanup();mgCleanup=()=>{};const r=mgRound;if(!r||r.finished)return;mgClearFX();r.finished=true;const b=mgDialog.querySelector('.mg-board');b.replaceChildren();let reward=null;if(!r.practice)reward=mgReward(r,ratio);const result=mgNode('div','mg-result',undefined,b);mgNode('h3','',ratio>=.8?'대성공!':ratio>=.4?'수고하셨습니다!':'다음에는 더 잘할 수 있어요!',result);mgNode('b','',score,result);mgNode('p','',message,result);mgNode('p','',r.boss?'송사장님의 특별 관리 완료!':r.practice?'연습 경기입니다.':!reward||reward.bonus===0?'이번에는 보너스 없이 마무리합니다.':reward.recovery?`참가 회원 ${reward.count}명 체력 회복!`:`참가 회원 ${reward.count}명 · 방의 성장 능력치 +${reward.bonus}`,result);if(reward?.tip)mgNode('p','mg-tip',`조교님께 조공 +${reward.tip}골드!`,result);mgButton(r.boss?'아침으로':'방으로 돌아가기',mgClose,result);mgSay('하… 하… 수고하셨습니다… 조교님!','blush');const finishRound=r;\n setTimeout(()=>{if(mgRound===finishRound&&mgDialog.open){mgClearFX();mgSay('수고하셨습니다, 조교님. 다음 일정은 예정대로 진행하겠습니다.','calm');}},1000);mgHearts(50,50,40);sound('ding');\n}\nfunction mgClock(step){let stopped=false,raf=0,lastT=performance.now();function frame(now){if(stopped)return;const dt=Math.min(.04,(now-lastT)/1000);lastT=now;if(!document.hidden&&!window.MEDIA_PAUSED)step(dt);if(!stopped)raf=requestAnimationFrame(frame);}raf=requestAnimationFrame(frame);mgCleanup=()=>{stopped=true;cancelAnimationFrame(raf);};}\nfunction mgWiggle(board){\n const stats=mgNode('div','mg-stats mg-wiggle-stats','',board),grid=mgNode('div','mg-animal-grid',undefined,board),progress=mgNode('div','mg-progress mg-wiggle-progress',undefined,board),bar=mgNode('i','',undefined,progress);\n const timeField=mgNode('strong','mg-wiggle-time','남은 25초',stats),scoreField=mgNode('strong','mg-wiggle-score','0점',stats),comboField=mgNode('strong','mg-wiggle-combo','연속 0',stats);\n const scene=board.closest('.mg-scene'),side=scene?.querySelector('.mg-side');\n function arrangeWiggle(){const wide=!!side&&matchMedia('(orientation:landscape) and (min-width:700px)').matches;\n  scene?.classList.toggle('mg-wiggle-landscape',wide);board.classList.toggle('mg-wiggle-square',wide);\n  if(wide){side.prepend(progress);side.prepend(stats);}else{board.prepend(stats);board.append(progress);}}\n arrangeWiggle();addEventListener('resize',arrangeWiggle);\n let time=25,age=0,windowT=1.35,target=-1,lastTarget=-1,hits=0,miss=0,combo=0,maxCombo=0,score=0,pause=.2,ended=false;\n const metrics=mgRound.wiggle={hits:0,misses:0,window:windowT,target:-1};const timers=[];const later=(fn,ms)=>timers.push(setTimeout(()=>{if(!ended)fn();},ms));\n const images=MG_IMAGES.animals.filter(Boolean).sort(()=>Math.random()-.5).slice(0,9);\n function tap(i,b){if(ended||time\u003c=0||target\u003c0)return;if(i===target){hits++;metrics.hits=hits;combo++;maxCombo=Math.max(maxCombo,combo);score+=10+Math.min(combo,10);target=-1;metrics.target=-1;pause=.38;age=0;b.classList.remove('wiggle');b.classList.add('hit');const fx=mgNode('span','mg-fx','찰싹!!',b),pad=mgNode('img','mg-paddle',undefined,b);pad.src=itemUrl('상품','paddle');pad.alt='패들';sound('slap');mgReact(combo>9?'cry':combo>4?'tear':'surprise',1);later(()=>{fx.remove();pad.remove();b.classList.remove('hit');},330);if(combo%3===0)mgEffect(1,70,35,130);if(combo%4===0)mgSay('후욱…! 다음 순서도 준비됐습니다, 조교님!','blush');}else{miss++;metrics.misses=miss;combo=0;const fx=mgNode('span','mg-fx','?!',b);b.classList.add('wrong');later(()=>{fx.remove();b.classList.remove('wrong');},250);sound('bonk');}}\n const cells=images.map((im,i)=>{const b=mgNode('button','mg-animal',undefined,grid);b.setAttribute('aria-label',`대상 ${i+1}`);const img=mgNode('img','animal-sprite',undefined,b);img.src=im.src;img.alt='움찔 찾기 대상';b.onpointerdown=e=>{if(e.pointerType==='mouse'&&e.button!==0)return;e.preventDefault();tap(i,b);};b.onclick=e=>{if(e.detail===0)tap(i,b);};return b;});\n mgSay('움찔하는 친구를 찾아 주세요. 움직이는 동안이 기회입니다!','calm');\n mgClock(dt=>{time-=dt;if(time\u003c=0)return mgFinish(`${score}점`,clamp(hits/22-miss*.025,0,1),`정답 ${hits}회 · 실수 ${miss}회 · 최고 연속 ${maxCombo}회`);if(pause>0)pause-=dt;else{age+=dt;if(target\u003c0||age>=windowT){if(target>=0){combo=0;cells[target].classList.remove('wiggle');}age=0;windowT=Math.max(.95,1.35-(25-time)*.016);do{target=Math.floor(Math.random()*9);}while(target===lastTarget);lastTarget=target;metrics.target=target;metrics.window=windowT;cells[target].classList.add('wiggle');}}timeField.textContent=`남은 ${Math.ceil(time)}초`;scoreField.textContent=`${score}점`;comboField.textContent=`연속 ${combo}`;bar.style.width=time/25*100+'%';});\n const stop=mgCleanup;mgCleanup=()=>{removeEventListener('resize',arrangeWiggle);ended=true;timers.forEach(clearTimeout);cells.forEach(b=>{b.onpointerdown=b.onclick=null;});stop();};\n}\nfunction mgCanvas(board,w=720,h=480){const wrap=mgNode('div','mg-canvas-wrap',undefined,board),c=mgNode('canvas','mg-canvas',undefined,wrap);c.width=w*2;c.height=h*2;c.dataset.width=w;c.dataset.height=h;const ctx=c.getContext('2d');ctx.scale(2,2);return {c,ctx,w,h};}\nfunction mgPoint(c,e){const r=c.getBoundingClientRect(),w=+c.dataset.width,h=+c.dataset.height,scale=Math.min(r.width/w,r.height/h);return {x:(e.clientX-r.left-(r.width-w*scale)/2)/scale,y:(e.clientY-r.top-(r.height-h*scale)/2)/scale};}\nfunction mgDrawImage(ctx,im,x,y,w,h,a=0){ctx.save();ctx.translate(x,y);ctx.rotate(a);if(im&&im.naturalWidth){const scale=Math.min(w/im.naturalWidth,h/im.naturalHeight),dw=im.naturalWidth*scale,dh=im.naturalHeight*scale;ctx.drawImage(im,-dw/2,-dh/2,dw,dh);}ctx.restore();}\nfunction mgMerge(board){\n const stats=mgNode('div','mg-stats','',board),{c,ctx,w,h}=mgCanvas(board,640,510),nextBox=mgNode('div','mg-next',undefined,board),nextImage=mgNode('img','',undefined,nextBox),nextText=mgNode('strong','','',nextBox);nextImage.alt='다음 소시지';\n const rail=mgNode('div','mg-food-rail',undefined,nextBox);MG_IMAGES.sausages.forEach((im,i)=>{const cell=mgNode('span','',undefined,rail),pic=mgNode('img','',undefined,cell);pic.src=im.src;pic.alt=`${i+1}단계`;mgNode('small','',String(i+1),cell);});\n const {Engine,World,Bodies,Body,Events}=Matter,engine=Engine.create({positionIterations:8,velocityIterations:8});engine.gravity.y=1.25;\n const left=43,right=w-43,floor=h-16,ceiling=100;\n World.add(engine.world,[Bodies.rectangle(left-15,h/2,30,h*2,{isStatic:true,friction:.4}),Bodies.rectangle(right+15,h/2,30,h*2,{isStatic:true,friction:.4}),Bodies.rectangle(w/2,floor+15,w,30,{isStatic:true,friction:.5})]);\n const sizes=MG_IMAGES.sausages.map((im,i)=>{const length=[72,94,120,151,187,228][i];return {length,height:length*im.naturalHeight/im.naturalWidth};});\n let time=60,score=0,aim=w/2,next=0,cool=0,elapsed=0,acc=0,overflow=0,bodies=[],mergeQueue=[],pops=[];const queued=new Set();\n function make(level,x,y,angle=Math.PI/2){const d=sizes[level],r=d.height/2,half=(d.length-d.height)/2,opts={friction:.45,restitution:.3,frictionAir:.008,density:.002};const parts=[Bodies.rectangle(x,y,Math.max(3,2*half),d.height,opts),Bodies.circle(x-half,y,r,opts),Bodies.circle(x+half,y,r,opts)];const b=Body.create({...opts,parts});Body.setAngle(b,angle);b.food={level,born:elapsed,pop:0};bodies.push(b);World.add(engine.world,b);return b;}\n function collide(event){for(const pair of event.pairs){const a=pair.bodyA.parent,b=pair.bodyB.parent;if(a===b||!a.food||!b.food||a.food.level!==b.food.level||a.food.level>=5||queued.has(a.id)||queued.has(b.id)||elapsed-a.food.born\u003c.18||elapsed-b.food.born\u003c.18)continue;queued.add(a.id);queued.add(b.id);mergeQueue.push([a,b]);}}\n Events.on(engine,'collisionStart',collide);Events.on(engine,'collisionActive',collide);\n function drop(){if(cool>0||time\u003c=0||mgRound?.finished)return;make(next,aim,55);next=Math.floor(Math.random()*3);cool=.4;sound('pop');refreshNext();}\n function refreshNext(){nextImage.src=MG_IMAGES.sausages[next].src;nextText.textContent=`다음 · ${next+1}단계`;}\n const move=e=>{const pt=mgPoint(c,e);aim=clamp(pt.x,left+35,right-35);};c.onpointermove=move;c.onpointerdown=e=>{e.preventDefault();c.setPointerCapture(e.pointerId);move(e);};c.onpointerup=e=>{e.preventDefault();move(e);drop();};c.onpointercancel=()=>{};refreshNext();mgSay('조교님, 같은 것끼리 부탁드립니다. 팬은 제가 챙기겠습니다.','blush');\n mgClock(dt=>{\n  time-=dt;elapsed+=dt;cool=Math.max(0,cool-dt);acc+=dt;while(acc>=1/120){Engine.update(engine,1000/120);acc-=1/120;}\n  for(const [a,b] of mergeQueue){const level=a.food.level+1,x=(a.position.x+b.position.x)/2,y=(a.position.y+b.position.y)/2,angle=(a.angle+b.angle)/2;World.remove(engine.world,a);World.remove(engine.world,b);bodies=bodies.filter(v=>v!==a&&v!==b);const n=make(level,x,y,angle);Body.setVelocity(n,{x:(a.velocity.x+b.velocity.x)*.2,y:-1.7});Body.setAngularVelocity(n,(a.angularVelocity+b.angularVelocity)*.3);n.food.pop=.25;score+=20*level;pops.push({x,y,t:.65,level});sound('boing');mgReact(level>=3?'cry':'surprise',level>=3?3:1);if(level>=2){mgImpact('뽕!!',level>=3?3:2);mgVoice(true);}if(level>=3)mgSay('어머…! 팬이 점점 좁아집니다, 조교님!','tear');}\n  mergeQueue=[];queued.clear();\n  const danger=bodies.some(b=>elapsed-b.food.born>1.8&&b.bounds.min.y\u003cceiling);overflow=danger?overflow+dt:Math.max(0,overflow-dt*2);\n  if(time\u003c=0||overflow>=2)return mgFinish(`${score}점`,Math.min(1,score/500),overflow>=2?'팬이 가득 찼습니다! 오늘은 여기까지 굽겠습니다.':'요리 시간 종료! 팬을 비우고 다음 손님을 모시겠습니다.');\n  stats.textContent=`${Math.ceil(time)}초　${score}점　최고 ${1+Math.max(0,...bodies.map(b=>b.food.level))}단계`;\n  ctx.clearRect(0,0,w,h);\n  // A deep pan, with handles and a visible rim, shares the collision bounds.\n  ctx.fillStyle='#65425944';ctx.beginPath();ctx.roundRect(left-9,ceiling+8,right-left+18,floor-ceiling+12,26);ctx.fill();\n  ctx.strokeStyle='#79566a';ctx.lineWidth=10;for(const x of [left-11,right+11]){ctx.beginPath();ctx.roundRect(x-13,(ceiling+floor)/2-48,26,96,10);ctx.stroke();}\n  const g=ctx.createLinearGradient(left,0,right,0);g.addColorStop(0,'#eedfcbeb');g.addColorStop(.5,'#fff4e3e6');g.addColorStop(1,'#e5cbb4ed');ctx.fillStyle=g;ctx.beginPath();ctx.roundRect(left,ceiling,right-left,floor-ceiling,18);ctx.fill();ctx.lineWidth=12;ctx.strokeStyle='#79566a';ctx.beginPath();ctx.moveTo(left,ceiling);ctx.lineTo(left,floor);ctx.lineTo(right,floor);ctx.lineTo(right,ceiling);ctx.stroke();ctx.lineWidth=3;ctx.strokeStyle='#d7a8ba';ctx.beginPath();ctx.moveTo(left+8,ceiling+10);ctx.lineTo(left+8,floor-8);ctx.lineTo(right-8,floor-8);ctx.lineTo(right-8,ceiling+10);ctx.stroke();\n  ctx.setLineDash([9,8]);ctx.lineWidth=2;ctx.strokeStyle=danger?'#ee6b81':'#aa9b80';ctx.beginPath();ctx.moveTo(left,ceiling);ctx.lineTo(right,ceiling);ctx.stroke();ctx.setLineDash([]);\n  ctx.strokeStyle='#8b9d8e80';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(aim,12);ctx.lineTo(aim,floor);ctx.stroke();ctx.globalAlpha=cool>0?.3:.92;const d=sizes[next];mgDrawImage(ctx,MG_IMAGES.sausages[next],aim,53,d.length,d.height,Math.PI/2);ctx.globalAlpha=1;\n  for(const b of bodies){const f=b.food,d=sizes[f.level];f.pop=Math.max(0,f.pop-dt);const scale=1+Math.sin(f.pop/.25*Math.PI)*.18;mgDrawImage(ctx,MG_IMAGES.sausages[f.level],b.position.x,b.position.y,d.length*scale,d.height*scale,b.angle);}\n  pops=pops.filter(p=>(p.t-=dt)>0);ctx.font='bold 25px sans-serif';ctx.textAlign='center';ctx.fillStyle='#b9647b';for(const p of pops)ctx.fillText('+'+20*p.level,p.x,p.y-25-(.65-p.t)*30);\n  if(danger){ctx.fillStyle='#d95d73';ctx.font='bold 19px sans-serif';ctx.fillText('넘치기 직전! '+Math.ceil((2-overflow)*10)/10+'초',w/2,ceiling+26);}\n });const cleanup=mgCleanup;mgCleanup=()=>{cleanup();Events.off(engine);World.clear(engine.world,false);Engine.clear(engine);};\n}\nfunction mgBalance(board){\n const level=clamp(mgRound.difficulty??0,0,2),cfg=[{pose:'balance-hips',u:.75,v:.49,wind:.65,limit:62,span:110},{pose:'balance-arms',u:.84,v:.44,wind:1,limit:50,span:90},{pose:'balance-legs',u:.78,v:.04,wind:1.45,limit:40,span:72}][level],pose=MG_IMAGES.poses[cfg.pose];\n const stats=mgNode('div','mg-stats','',board),{c,ctx,w,h}=mgCanvas(board,720,480),controls=mgNode('div','mg-controls',undefined,board);let left=false,right=false,time=25,angle=.015,velocity=0,cup=0,cupV=0,falls=0,stable=0,reset=0,elapsed=0,lastJolt=0,fallCup=null;\n const scale=Math.min(540/pose.naturalWidth,330/pose.naturalHeight),pw=pose.naturalWidth*scale,ph=pose.naturalHeight*scale,cx=w/2,cy=250,sx=(cfg.u-.5)*pw,sy=(cfg.v-.5)*ph,span=cfg.span;\n function hold(label,key){const b=mgNode('button','',label,controls);b.setAttribute('aria-label',key==='left'?'왼쪽 균형':'오른쪽 균형');b.onpointerdown=e=>{e.preventDefault();b.setPointerCapture(e.pointerId);if(key==='left')left=true;else right=true;};const end=()=>{if(key==='left')left=false;else right=false;};b.onpointerup=end;b.onpointercancel=end;b.onlostpointercapture=end;}hold('◀ 왼쪽','left');hold('오른쪽 ▶','right');\n const kd=e=>{if(e.key==='ArrowLeft'){left=true;e.preventDefault();}if(e.key==='ArrowRight'){right=true;e.preventDefault();}},ku=e=>{if(e.key==='ArrowLeft')left=false;if(e.key==='ArrowRight')right=false;};addEventListener('keydown',kd);addEventListener('keyup',ku);\n function drawCup(x,y,a=0){ctx.save();ctx.translate(x,y);ctx.rotate(a);ctx.fillStyle='#fffdf5';ctx.strokeStyle='#9a7490';ctx.lineWidth=3;ctx.beginPath();ctx.roundRect(-17,-39,34,38,5);ctx.fill();ctx.stroke();ctx.beginPath();ctx.arc(24,-22,10,-Math.PI/2,Math.PI/2);ctx.stroke();ctx.fillStyle='#8ed8e6';ctx.fillRect(-13,-24,26,18);ctx.restore();}\n mgSay('네, 이 자세로 준비됐습니다. 컵도 올려 주십시오.','blush');\n mgClock(dt=>{time-=dt;elapsed+=dt;if(reset>0){reset-=dt;if(fallCup){fallCup.vy+=700*dt;fallCup.y+=fallCup.vy*dt;fallCup.x+=fallCup.vx*dt;fallCup.a+=dt*6;}}else{const input=(right?1:0)-(left?1:0),wind=(Math.sin(elapsed*2.1)*.16+Math.sin(elapsed*3.7)*.1)*cfg.wind;velocity+=(input*1.65+wind+angle*.8)*dt;velocity*=Math.exp(-2.8*dt);angle=clamp(angle+velocity*dt,-.48,.48);cupV+=(Math.sin(angle)*115+wind*6)*dt;cupV*=Math.exp(-.65*dt);cup+=cupV*dt;if(Math.abs(cup)\u003ccfg.limit*.55)stable+=dt;\n  if(Math.abs(cup)>cfg.limit*.65&&elapsed-lastJolt>2){lastJolt=elapsed;mgReact('surprise',1);mgSay('앗…! 네, 버티고 있습니다, 조교님!','tear');mgHearts(46,48,16);}\n  if(Math.abs(cup)>cfg.limit){falls++;reset=1.1;fallCup={x:cx+sx+Math.sign(cup)*span/2,y:cy+sy,vx:Math.sign(cup)*85,vy:-90,a:angle};cup=0;cupV=0;velocity=0;left=right=false;angle=(Math.random()-.5)*.08;sound('bonk');mgReact('cry',3);mgImpact('와장창!!',3);mgVoice(true);mgSay('앗…! 네, 새 컵으로 다시 준비하겠습니다!','cry');}}\n  if(time\u003c=0||falls>=3)return mgFinish(`${Math.round(stable*10)}점`,clamp(stable/25,0,1),`${['엉덩이','팔','다리'][level]} 균형 · ${Math.min(25,elapsed).toFixed(1)}초 · 컵 떨어짐 ${falls}회`);\n  stats.textContent=`${Math.ceil(time)}초　${['쉬움 · 엉덩이','보통 · 팔','어려움 · 다리'][level]}　컵 ${3-falls}/3`;\n  ctx.clearRect(0,0,w,h);ctx.fillStyle='#748d6c40';ctx.beginPath();ctx.ellipse(cx,427,Math.min(260,pw*.6),17,0,0,Math.PI*2);ctx.fill();ctx.save();ctx.translate(cx,cy);ctx.rotate(angle);ctx.drawImage(pose,-pw/2,-ph/2,pw,ph);ctx.fillStyle='#d2ad77';ctx.strokeStyle='#a7805f';ctx.lineWidth=2;ctx.beginPath();ctx.roundRect(sx-span/2,sy,span,6,3);ctx.fill();ctx.stroke();\n  if(reset\u003c=0){const wobble=Math.abs(cup)>cfg.limit*.65?Math.sin(elapsed*36)*.05:0;drawCup(sx+cup/cfg.limit*span/2,sy,wobble);}ctx.restore();if(reset>0&&fallCup)drawCup(fallCup.x,fallCup.y,fallCup.a);\n  ctx.fillStyle='#fff9';ctx.beginPath();ctx.roundRect(200,451,320,10,5);ctx.fill();ctx.fillStyle=Math.abs(cup)>cfg.limit*.7?'#ec8897':'#76b5a1';ctx.fillRect(356+clamp(cup/cfg.limit,-1,1)*150,447,8,18);\n });const cleanup=mgCleanup;mgCleanup=()=>{cleanup();removeEventListener('keydown',kd);removeEventListener('keyup',ku);};\n}\nfunction mgTap(board){\n const stats=mgNode('div','mg-stats','',board),stage=mgNode('div','mg-tap-stage',undefined,board);\n const colors=['#db779f','#49ac9e','#9975c5'];let elapsed=0,taps=0,lastTalk=-10,ended=false;const meters=[68,75,82];\n const actors=[0,1,2].map(i=>{\n  const actor=mgNode('div','mg-tap-person',undefined,stage);actor.style.setProperty('--mat',colors[i]);\n  const target=mgNode('button','mg-tap-target',undefined,actor);target.setAttribute('aria-label',`${i+1}번 터치`);const img=mgNode('img','mg-actor-sprite',undefined,target);img.src=MG_IMAGES.poses['tap'+(i+1)].src;img.alt=`${i+1}번 엎드린 회원`;\n  const head=mgNode('div','mg-head-meter',undefined,actor);mgNode('strong','',`${i+1}번`,head);const gauge=mgNode('div','mg-tap-gauge',undefined,head),bar=mgNode('i','',undefined,gauge),value=mgNode('span','mg-tap-value','',head);gauge.setAttribute('role','progressbar');gauge.setAttribute('aria-label',`${i+1}번 게이지`);gauge.setAttribute('aria-valuemin','0');gauge.setAttribute('aria-valuemax','100');\n  const tap=()=>{if(ended)return;meters[i]=Math.min(100,meters[i]+9);taps++;\n   img.getAnimations().forEach(a=>a.cancel());img.animate([{transform:'none'},{transform:'translate(-6px,8px) rotate(-3deg) scale(1.05,.88)'},{transform:'translate(5px,-15px) rotate(2deg) scale(.98,1.06)'},{transform:'none'}],{duration:260});\n   const paddle=mgNode('img','mg-tap-paddle',undefined,target);paddle.src=itemUrl('상품','paddle');paddle.alt='';setTimeout(()=>paddle.remove(),260);\n   sound('slap');const f=['surprise','tear','cry','blush'][taps%4];mgReact(f,2);\n   const r=actor.getBoundingClientRect(),sr=mgDialog.querySelector('.mg-scene').getBoundingClientRect(),x=(r.left+r.width*.65-sr.left)/sr.width*100,y=(r.top+r.height*.5-sr.top)/sr.height*100;mgEffect(taps%4===0?18:1,x,y,180);mgHearts(x,y,taps%6===0?36:12);\n   if(elapsed-lastTalk>1.5){lastTalk=elapsed;const low=meters.indexOf(Math.min(...meters));mgSay(meters[low]\u003c25?`${low+1}번도 기다리고 있습니다… 조교님!`:['앗! 네, 준비되어 있습니다!','흐읍…! 다음 순서도 부탁드립니다!','하…! 네, 세 분 모두 챙겨 주십시오!'][i],f);}paint();\n  };\n  target.onpointerdown=e=>{e.preventDefault();tap();};target.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();tap();}};\n  const placeHead=()=>{const rw=target.clientWidth,rh=Math.max(1,target.clientHeight-20),ratio=MG_IMAGES.poses['tap'+(i+1)].naturalWidth/MG_IMAGES.poses['tap'+(i+1)].naturalHeight,dh=Math.min(rh,rw/ratio),dw=dh*ratio;head.style.top=Math.max(0,target.clientHeight-dh+dh*.24-head.offsetHeight-3)+'px';head.style.left=((rw-dw)/2+dw*.04)+'px';};\n  return {actor,bar,value,gauge,placeHead};\n });\n function paint(){actors.forEach((o,i)=>{const v=Math.max(0,meters[i]);o.bar.style.width=v+'%';o.value.textContent=Math.ceil(v)+'/100';o.gauge.setAttribute('aria-valuenow',String(Math.ceil(v)));o.actor.classList.toggle('danger',v\u003c25);});stats.textContent=`${elapsed.toFixed(1)}초 유지　찰싹 ${taps}회`;}\n mgNode('p','mg-small','세 사람을 직접 눌러 주세요. 한 사람이라도 게이지가 바닥나면 종료!',board);mgSay('세 명 모두 준비됐습니다. 잘 부탁드립니다, 조교님!','blush');paint();const ro=new ResizeObserver(()=>actors.forEach(o=>o.placeHead()));ro.observe(stage);requestAnimationFrame(()=>actors.forEach(o=>o.placeHead()));\n mgClock(dt=>{elapsed+=dt;meters.forEach((_,i)=>{meters[i]-=(7.5+elapsed*.35)*(1+i*.04)*dt;});paint();const lost=meters.findIndex(x=>x\u003c=0);if(lost>=0){ended=true;mgFinish(`${elapsed.toFixed(1)}초`,Math.min(1,elapsed/45),`찰싹 ${taps}회 · ${lost+1}번 게이지 소진. 다음에는 골고루 부탁드립니다!`);}});const stop=mgCleanup;mgCleanup=()=>{ro.disconnect();stop();};\n}\nfunction mgBadges(){const offer=mgState().offer;const key=offer?offer.b+':'+offer.i+':'+offer.kind+':'+offer.until:'';if(key&&document.querySelector('.mg-badge')?.dataset.key===key)return;document.querySelectorAll('.mg-badge').forEach(e=>e.remove());if(!offer)return;for(const r of document.querySelectorAll('.room')){const b=r.closest('.building')?.dataset.kind;if(b===offer.b&&+r.dataset.slot===offer.i){const badge=mgNode('button','mg-badge','🎉 '+MG_TITLES[offer.kind],r);badge.dataset.key=key;badge.onclick=e=>{e.stopPropagation();openMiniGame(offer);};}}}\nfunction mgOpenHub(){if(S.campaign?.phase==='night')return campaignShowSong();mgOffer();const offer=mgState().offer;const eligible=mgEligible();if(!eligible.length)return toast('체력 25 이상인 회원이 있는 방에서 즐길 수 있습니다.');const r=eligible.find(r=>cur&&cur.k===r.b&&cur.i===r.i)||eligible[0];const d=document.createElement('dialog');d.innerHTML='\u003cdiv class=\"dhead\">\u003ch2>미니게임 연습\u003c/h2>\u003cbutton class=\"close\">×\u003c/button>\u003c/div>\u003cp>랜덤 행사는 방에 🎉 표시로 나타납니다. 지금은 보상 없는 연습을 즐길 수 있습니다.\u003c/p>';d.querySelector('button').onclick=()=>d.close();if(offer){const event=mgNode('button','mg-start','🎉 '+MG_TITLES[offer.kind]+' · '+mgRoomName(offer),d);event.style.margin='8px';event.onclick=()=>{d.close();openMiniGame(offer);};}MG_TITLES.forEach((title,kind)=>{const b=mgNode('button','pill',title,d);b.style.margin='8px';b.onclick=()=>{d.close();openMiniGame({...r,kind},true);};});d.addEventListener('close',()=>d.remove());document.body.append(d);d.showModal();}\nconst mgHub=mgNode('button','','미니게임',document.querySelector('footer'));mgHub.id='btnMiniGames';mgHub.onclick=mgOpenHub;\n\nconst mgAlert=mgNode('button','mg-alert','',document.body);mgAlert.id='mgAlert';mgAlert.hidden=true;let mgAlertKey='';\nfunction mgRoomEl(o){for(const r of document.querySelectorAll('.room')){const b=r.closest('.building')?.dataset.kind;if(b===o.b&&+r.dataset.slot===o.i&&r.offsetParent!==null)return r;}return null;}\nfunction mgInView(r){const v=document.getElementById('view');if(!v)return true;const a=v.getBoundingClientRect(),q=r.getBoundingClientRect();return q.bottom>a.top+24&&q.top\u003ca.bottom-24&&q.right>a.left+12&&q.left\u003ca.right-12;}\nfunction mgAlertUpdate(){const o=mgState().offer;if(!o||mgDialog.open){mgAlert.hidden=true;mgAlertKey='';return;}\n  const key=o.b+':'+o.i+':'+o.kind+':'+o.until,left=Math.max(0,Math.ceil((o.until-S.t)*S.cfg.dayMin*60/S.cfg.speed)),r=mgRoomEl(o),vis=!!r&&mgInView(r),dock=document.getElementById('dock');\n  mgAlert.textContent='🎉 '+MG_TITLES[o.kind]+' · '+mgRoomName(o)+' · '+left+'초 '+(vis?'▶ 시작':'→ 이동');\n  mgAlert.style.bottom=((dock?dock.offsetHeight:78)+12)+'px';mgAlert.hidden=false;\n  if(key!==mgAlertKey){mgAlertKey=key;try{sound('sparkle');}catch{}try{navigator.vibrate&&navigator.vibrate([80,60,80]);}catch{}}}\nmgAlert.onclick=()=>{const o=mgState().offer;if(!o)return;let r=mgRoomEl(o);if(r&&mgInView(r))return openMiniGame(o);\n  if(typeof focus!=='undefined'&&focus!=='all'&&focus!==o.b){focus=o.b;applyFocus();}\n  r=mgRoomEl(o);if(r){r.scrollIntoView({block:'center',inline:'center',behavior:'smooth'});mgBadges();const bd=r.querySelector('.mg-badge');if(bd){bd.classList.add('mg-ping');setTimeout(()=>bd.classList.remove('mg-ping'),2800);}}\n  setTimeout(mgAlertUpdate,600);};\nsetInterval(()=>{if(mgDialog.open){mgAlert.hidden=true;return;}if(document.hidden)return;mgOffer();mgBadges();mgAlertUpdate();mgHub.textContent=mgState().offer?'🎉 방 이벤트':'미니게임';},1000);\n\nfunction mgFetch(board){\n const mount=mgNode('div','',undefined,board);mount.style.cssText='flex:1;min-height:0';\n const bg=new Image();bg.src=mgRoomBG(mgRound);const round=mgRound;\n const game=new FetchGame(mount,{motion:window.HERO_MOTION,assets:{...MG_IMAGES.fetch,duck:MG_IMAGES.behind.duck},bg,onEvent:event=>{if(event==='collision'){sound('bonk');mgReact('surprise',2);mgSay('으악! 물건은 아직 안 놓쳤습니다!', 'tear');}else if(event==='jump')sound('whoosh');else if(event==='clear'){sound('pop');if(game.s.cleared%3===0){mgSay('후욱…! 이번엔 넘었습니다, 조교님!', 'blush');mgHearts(75,40,22);}}else if(event==='fetch'){mgSay('물어왔습니다! 이제 숨 좀…!', 'blush');mgHearts(50,45,40);}} ,onFinish:result=>{round.fetch=result;game.destroy();mgFinish(result.score+'점',clamp(1-result.collisions*.09-Math.max(0,result.time-30)*.008,.15,1),`회수 성공 · ${result.time.toFixed(1)}초 · 충돌 ${result.collisions}회`);}});\n round.fetchGame=game;mgCleanup=()=>game.destroy();\n}\n\n", "behind": "/* 뒤를 조심!! — ordinary props, pull-and-release, cartoon reactions. */\nconst MG_THROW_ITEMS=[\n {id:'ball',name:'고무공',hint:'통통 튀어요',speed:1,gravity:620,air:.025,bounce:.84,spin:5,size:46},\n {id:'duck',name:'고무오리',hint:'가볍게 떠요',speed:.91,gravity:430,air:.24,bounce:.3,spin:1.6,size:56},\n {id:'slipper',name:'슬리퍼',hint:'빙글빙글 빨라요',speed:1.16,gravity:790,air:.065,bounce:.1,spin:12,size:66}\n];\n// The same integrator drives live shots and the dotted preview.\nfunction mgThrowStep(p,item,dt,scale,floor){\n p.age+=dt;p.vx*=Math.exp(-item.air*dt);p.vy*=Math.exp(-item.air*dt);p.vy+=item.gravity*scale*dt;\n p.x+=p.vx*dt;p.y+=p.vy*dt;p.angle+=item.spin*dt;\n if(p.y>floor&&p.vy>0){p.y=floor;p.vy=-p.vy*item.bounce;p.vx*=.78;p.bounces++;return true;}\n return false;\n}\nfunction mgThrowCrosses(x0,y0,x1,y1,x,y,rx,ry){\n const ax=(x0-x)/rx,ay=(y0-y)/ry,dx=(x1-x0)/rx,dy=(y1-y0)/ry;\n const t=clamp(-(ax*dx+ay*dy)/(dx*dx+dy*dy||1),0,1);\n return (ax+dx*t)**2+(ay+dy*t)**2\u003c=1;\n}\nconst mgBehindStyle=document.createElement('style');\nmgBehindStyle.textContent=`\n.mg-behind-scene .mg-canvas-wrap{margin-bottom:0;overflow:visible}.mg-preview.behind-preview img{width:85%;max-width:85%;height:100%}\n.mg-throw-info{display:flex;align-items:center;justify-content:space-between;gap:8px;flex:none;min-height:61px;padding:4px 8px;border-top:1px solid #fff8;background:#fff5df99;border-radius:12px;color:#526f64}\n.mg-throw-current,.mg-throw-next{display:flex;align-items:center;gap:8px;min-width:0}.mg-throw-current img{width:54px;height:48px;object-fit:contain}.mg-throw-current strong{display:block;font-size:15px}.mg-throw-current small{display:block;font-size:11px;color:#7d8571}.mg-throw-next{font-size:11px}.mg-throw-next img{width:34px;height:32px;object-fit:contain}.mg-throw-power{height:6px;flex:none;border-radius:6px;background:#d4d5bd;margin:5px 8px;overflow:hidden}.mg-throw-power i{height:100%;display:block;width:0;background:linear-gradient(90deg,#87cbaa,#f7cf65,#ef8994);transition:width .03s}\n.mg-behind-fly{position:absolute;width:var(--actor-size);height:var(--actor-size);object-fit:contain;transform:translate(-50%,-50%);pointer-events:none;z-index:5;animation:mgBehindFly .88s cubic-bezier(.2,.55,.4,1) forwards;transform-origin:50% 55%}\n.mg-behind-shout{position:absolute;font-size:clamp(25px,5vw,62px);font-weight:1000;color:#fff4af;-webkit-text-stroke:1px #7e3547;text-shadow:3px 4px #8e3a59;white-space:nowrap;animation:mgBehindShout .85s forwards;z-index:6;pointer-events:none}\n@keyframes mgBehindFly{0%{transform:translate(-50%,-50%) scale(.85) rotate(-5deg)}24%{transform:translate(-50%,-56%) scale(1.35) rotate(6deg)}67%{opacity:1;transform:translate(-30%,-90%) scale(3.8) rotate(18deg)}100%{opacity:0;transform:translate(var(--fly-x,80vw),var(--fly-y,-120vh)) scale(5.2) rotate(var(--fly-rot,33deg))}}\n@keyframes mgBehindShout{0%{opacity:0;transform:translate(-50%,-50%) scale(.3) rotate(-15deg)}18%{opacity:1;transform:translate(-50%,-65%) scale(1.1) rotate(-8deg)}80%{opacity:1}100%{opacity:0;transform:translate(-50%,-130%) scale(1.15)}}\n@media(max-width:650px) and (orientation:portrait){.mg-behind-scene .mg-board{padding:8px}.mg-throw-info{padding:3px 5px;min-height:53px;gap:5px}.mg-throw-current img{width:43px;height:41px}.mg-throw-current strong{font-size:12px}.mg-throw-next{font-size:10px;gap:4px}.mg-throw-next img{width:28px;height:28px}.mg-behind-scene .mg-stats{font-size:13px}.mg-behind-scene .mg-small{font-size:10px;margin:3px 0}}\n`;\ndocument.head.append(mgBehindStyle);\n\nfunction mgBehind(board){\n const portrait=board.clientHeight>board.clientWidth*1.05;\n const stats=mgNode('div','mg-stats','',board),{c,ctx,w,h}=mgCanvas(board,portrait?600:840,portrait?700:540);\n c.tabIndex=0;c.setAttribute('aria-label','아래 소품을 당겼다가 놓아 캐릭터 맞히기');\n const info=mgNode('div','mg-throw-info',undefined,board),currentBox=mgNode('div','mg-throw-current',undefined,info),currentImage=mgNode('img','',undefined,currentBox),currentText=mgNode('div','',undefined,currentBox);\n const currentName=mgNode('strong','',undefined,currentText),currentHint=mgNode('small','',undefined,currentText),nextBox=mgNode('div','mg-throw-next',undefined,info);\n mgNode('span','','다음',nextBox);const nextImage=mgNode('img','',undefined,nextBox),nextName=mgNode('span','',undefined,nextBox);\n const power=mgNode('div','mg-throw-power',undefined,board),powerBar=mgNode('i','',undefined,power);\n mgNode('p','mg-small','아래로 당겨서 놓기 · 방향으로 조준, 길이로 힘 조절',board);\n const scale=h/600,origin={x:w*.5,y:h*.93},floor=h*.95,maxPull=h*.21,gain=7.15;\n const actorSize=Math.min(h*.65,w*.62),foot=h*.84,hitY=foot-actorSize*.24,rx=actorSize*.115,ry=actorSize*.08;\n const round=mgRound,metrics=round.behind={shots:0,hits:0,misses:0,maxCombo:0,bounceHits:0};\n let elapsed=0,time=30,score=0,combo=0,acc=0,cool=0,spawn=0,serial=0,shotSerial=0,ended=false,pointer=null,start=null,aim={x:0,y:maxPull*.78};\n let current=0,next=1,bag=[2],shots=[],marks=[],target;\n function takeItem(){if(!bag.length){bag=[0,1,2];for(let i=bag.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[bag[i],bag[j]]=[bag[j],bag[i]];}}const n=bag.shift();if(n===next&&bag.length){bag.push(n);return bag.shift();}return n;}\n function refreshItems(){const a=MG_THROW_ITEMS[current],b=MG_THROW_ITEMS[next];currentImage.src=MG_IMAGES.behind[a.id].src;currentImage.alt=a.name;currentName.textContent=a.name;currentHint.textContent=a.hint;nextImage.src=MG_IMAGES.behind[b.id].src;nextImage.alt=b.name;nextName.textContent=b.name;}\n function newTarget(first=false){\n  // Animation frames only control folding/opening. Horizontal travel uses an independent clock.\n  // Vary starting position and loop period, so the target never opens at a fixed location.\n  const slidePhase=Math.random()*Math.PI*2;\n  const slidePeriod=7.2+Math.random()*.8;\n  const sideInset=Math.max(actorSize*.53+8,w*.15),radius=Math.max(0,(w-2*sideInset)*.5);\n  const from=w*.5+radius*Math.sin(slidePhase);\n  target={id:++serial,x:from,age:0,entry:first?0:.18,entryFrom:from,phase:'travel',frame:0,frameTime:0,hold:0,dir:Math.cos(slidePhase)>=0?1:-1,foot:foot,hitY:hitY,open:false,slidePhase,slidePeriod,slideTime:0};\n  spawn=0;\n }\n function updateTarget(dt){\n  if(!target)return;\n  const t=target;t.age+=dt;t.entry=Math.max(0,t.entry-dt);\n  const frameSeconds=.22;\n  if(t.phase==='hold'){\n   t.hold-=dt;\n   if(t.hold\u003c=0){t.phase='travel';t.frame=6;t.frameTime=0;t.open=false;}\n  }else{\n   t.frameTime+=dt;\n   while(t.frameTime>=frameSeconds){\n    t.frameTime-=frameSeconds;\n    t.frame++;\n    if(t.frame===5){t.phase='hold';t.hold=.95;t.frameTime=0;t.open=true;break;}\n    if(t.frame>=11){\n     t.frame=0;t.frameTime=0;\n     // The sprite's fold/unfold loop does not change sliding direction.\n     break;\n    }\n   }\n  }\n  // Sliding is continuous even while the leg-spread pose is held for a hit.\n  t.slideTime+=dt;\n  const theta=t.slidePhase+2*Math.PI*t.slideTime/t.slidePeriod;\n  const swing=Math.sin(theta);\n  const sideInset=Math.max(actorSize*.53+8,w*.15),radius=Math.max(0,(w-2*sideInset)*.5);\n  t.x=w*.5+radius*swing;\n  t.dir=Math.cos(theta)>=0?1:-1;\n  t.foot=foot-h*.07*(1-swing*swing);\n  t.hitY=t.foot-actorSize*.24;\n  t.open=t.phase==='hold'&&t.entry===0;\n }\n function shotFromAim(index=current){const item=MG_THROW_ITEMS[index];return {id:++shotSerial,kind:index,x:origin.x,y:origin.y,vx:-aim.x*gain*item.speed,vy:-aim.y*gain*item.speed,age:0,angle:0,bounces:0,target:target?.id,trail:[]};}\n function updatePower(){powerBar.style.width=pointer!==null?Math.round(Math.hypot(aim.x,aim.y)/maxPull*100)+'%':'0%';}\n function finish(){if(ended)return;ended=true;pointer=null;powerBar.style.width='0%';mgFinish(`${score}점`,clamp(metrics.hits/8-metrics.misses*.012,0,1),`명중 ${metrics.hits}회 · 최고 연속 ${metrics.maxCombo}회 · 통통 명중 ${metrics.bounceHits}회`);}\n function fire(){\n  if(ended||time\u003c=0||cool>0||shots.length>=3||!target||target.entry>0||Math.hypot(aim.x,aim.y)\u003c12)return false;\n  shots.push(shotFromAim());metrics.shots++;cool=.23;current=next;next=takeItem();refreshItems();sound('whoosh');return true;\n }\n function adjust(point){let x=clamp(point.x-start.x,-maxPull*.8,maxPull*.8),y=clamp(point.y-start.y,0,maxPull);const length=Math.hypot(x,y);if(length>maxPull){x*=maxPull/length;y*=maxPull/length;}aim={x,y};updatePower();}\n c.onpointerdown=e=>{const pt=mgPoint(c,e);if(pointer!==null||ended||pt.x\u003c0||pt.x>w||pt.y\u003ch*.5||pt.y>h||cool>0||!target)return;e.preventDefault();pointer=e.pointerId;start=pt;aim={x:0,y:0};try{c.setPointerCapture(pointer);}catch{}updatePower();};\n c.onpointermove=e=>{if(e.pointerId!==pointer)return;e.preventDefault();adjust(mgPoint(c,e));};\n c.onpointerup=e=>{if(e.pointerId!==pointer)return;e.preventDefault();adjust(mgPoint(c,e));fire();const id=pointer;pointer=null;updatePower();try{c.releasePointerCapture(id);}catch{}};\n const cancel=e=>{if(e.pointerId!==pointer)return;pointer=null;updatePower();};c.onpointercancel=cancel;c.onlostpointercapture=cancel;\n c.onkeydown=e=>{if(ended)return;if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' ','Enter'].includes(e.key)){e.preventDefault();if(e.key==='ArrowLeft')aim.x=clamp(aim.x+7,-maxPull*.6,maxPull*.6);if(e.key==='ArrowRight')aim.x=clamp(aim.x-7,-maxPull*.6,maxPull*.6);if(e.key==='ArrowUp')aim.y=clamp(aim.y+7,16,maxPull);if(e.key==='ArrowDown')aim.y=clamp(aim.y-7,16,maxPull);if(e.key===' '||e.key==='Enter')fire();}};\n function fly(x,points){\n  const layer=mgDialog.querySelector('.mg-fx-layer'),r=c.getBoundingClientRect(),sr=layer.getBoundingClientRect(),s=Math.min(r.width/w,r.height/h),ox=r.left+(r.width-w*s)/2,oy=r.top+(r.height-h*s)/2;\n  const el=mgNode('img','mg-behind-fly',undefined,layer);el.src=MG_IMAGES.behind.fly1.src;el.alt='깜짝 놀라 날아가는 캐릭터';el.style.cssText=`left:${ox+x*s-sr.left}px;top:${oy+((target?.foot??foot)-actorSize*.5)*s-sr.top}px;--actor-size:${actorSize*s}px`;\n  const flight=(metrics.hits-1)%3,flightPaths=[['-75vw','-58vh','-42deg'],['0vw','-105vh','3deg'],['75vw','-58vh','42deg']];\n  el.style.setProperty('--fly-x',flightPaths[flight][0]);\n  el.style.setProperty('--fly-y',flightPaths[flight][1]);\n  el.style.setProperty('--fly-rot',flightPaths[flight][2]);\n  const shout=mgNode('span','mg-behind-shout','으아악!!',layer);shout.style.cssText=`left:${ox+x*s-sr.left}px;top:${oy+foot*.6*s-sr.top}px`;\n  setTimeout(()=>{el.remove();shout.remove();},930);\n  const frame=MG_IMAGES.behind['fly'+(1+(metrics.hits-1)%3)];if(frame)el.src=frame.src;\n  mgEffect(3,clamp((ox+x*s-sr.left)/sr.width*100,20,80),35,180);mgHearts(50,45,metrics.hits%3===0?36:14);mgReact(metrics.hits%4===0?'tear':'surprise',2);mgVoice(true);sound('boing');\n  marks.push({x,y:target?.hitY??hitY,text:'+'+points,t:.8});\n }\n function hit(p){\n  const t=target;metrics.hits++;combo++;metrics.maxCombo=Math.max(metrics.maxCombo,combo);if(p.bounces)metrics.bounceHits++;\n  const quick=Math.round(50*clamp(1-t.age/4,0,1)),mult=Math.min(2,1+Math.floor((combo-1)/3)*.25),points=Math.round((100+quick+(p.bounces?25:0))*mult);score+=points;\n  fly(t.x,points);shots=[];target=null;spawn=.3;\n  mgSay(p.bounces?'안심하기에는 조금 일렀습니다…!':combo>=4?'다음 분, 준비… 으앗! 순서가 너무 빠릅니다!':'네, 다음 순서 바로 들어갑니다!','surprise');\n }\n function draw(dt){\n  ctx.clearRect(0,0,w,h);\n  ctx.fillStyle='#fff4db2b';ctx.beginPath();ctx.ellipse(w/2,h*.73,w*.42,h*.18,0,0,Math.PI*2);ctx.fill();\n  ctx.strokeStyle='#ffffff65';ctx.lineWidth=2;for(let i=0;i\u003c4;i++){const y=h*(.59+i*.105);ctx.beginPath();ctx.moveTo(w*.07,y);ctx.lineTo(w*.93,y);ctx.stroke();}\n  ctx.fillStyle='#55796535';ctx.beginPath();if(target)ctx.ellipse(target.x,target.foot,actorSize*.25,actorSize*.045,0,0,Math.PI*2);ctx.fill();\n  if(target){\n   let x=target.x;if(target.entry>0){const q=1-target.entry/.18;x=target.entryFrom+(target.x-target.entryFrom)*(1-(1-q)**3);}\n   const frame=MG_IMAGES.behind['crawl'+(target.frame+1)]||MG_IMAGES.behind.crawl1;\n   ctx.save();ctx.translate(x,target.foot-actorSize*.5);\n   if(target.dir\u003c0)ctx.scale(-1,1);\n   mgDrawImage(ctx,frame,0,0,actorSize,actorSize);\n   ctx.restore();\n\n  }\n  // The preview stops early; the player must still read the moving character.\n  if(pointer!==null){\n   ctx.strokeStyle='#b98169';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(origin.x-23,origin.y+8);ctx.lineTo(origin.x+aim.x*.36,origin.y+aim.y*.36);ctx.lineTo(origin.x+23,origin.y+8);ctx.stroke();\n   const pred=shotFromAim();shotSerial--;for(let n=0;n\u003c22;n++){mgThrowStep(pred,MG_THROW_ITEMS[current],.035,scale,floor);if(n%2===0){ctx.globalAlpha=1-n/26;ctx.fillStyle='#fff8b8';ctx.strokeStyle='#8b8063';ctx.lineWidth=1;ctx.beginPath();ctx.arc(pred.x,pred.y,4.5-n*.08,0,Math.PI*2);ctx.fill();ctx.stroke();}}ctx.globalAlpha=1;\n  }\n  ctx.fillStyle='#fef2cecc';ctx.strokeStyle='#c49b74';ctx.lineWidth=3;ctx.beginPath();ctx.ellipse(origin.x,origin.y+12,49,21,0,0,Math.PI*2);ctx.fill();ctx.stroke();\n  mgDrawImage(ctx,MG_IMAGES.behind[MG_THROW_ITEMS[current].id],origin.x,origin.y-8,62,62,Math.sin(elapsed*2)*.06);\n  if(!metrics.shots&&pointer===null){ctx.fillStyle='#627f6b';ctx.font=`bold ${Math.round(17*scale)}px sans-serif`;ctx.textAlign='center';ctx.fillText('↓ 아래로 당겼다가 놓으세요',origin.x,origin.y+57*scale);}\n  for(const p of shots){\n   for(let i=0;i\u003cp.trail.length;i++){const a=p.trail[i];ctx.globalAlpha=(i+1)/p.trail.length*.22;ctx.fillStyle='#fff7cb';ctx.beginPath();ctx.arc(a.x,a.y,3+(i/p.trail.length)*3,0,Math.PI*2);ctx.fill();}ctx.globalAlpha=1;\n   const item=MG_THROW_ITEMS[p.kind];mgDrawImage(ctx,MG_IMAGES.behind[item.id],p.x,p.y,item.size,item.size,p.angle);\n  }\n  marks=marks.filter(m=>(m.t-=dt)>0);ctx.textAlign='center';ctx.font=`1000 ${Math.round(30*scale)}px sans-serif`;for(const m of marks){ctx.globalAlpha=Math.min(1,m.t*3);ctx.fillStyle='#fff4ab';ctx.strokeStyle='#955271';ctx.lineWidth=4;ctx.strokeText(m.text,m.x,m.y-(.8-m.t)*80);ctx.fillText(m.text,m.x,m.y-(.8-m.t)*80);}ctx.globalAlpha=1;\n }\n refreshItems();newTarget(true);mgSay('준비됐습니다. 뒤는 제가 살피겠습니다!','calm');\n mgClock(dt=>{\n  if(ended)return;time=Math.max(0,time-dt);elapsed+=dt;cool=Math.max(0,cool-dt);if(time\u003c=0){finish();return;}\n  acc+=dt;while(acc>=1/120){const step=1/120;acc-=step;\n   updateTarget(step);if(!target&&(spawn-=step)\u003c=0)newTarget();\n   for(const p of [...shots]){if(!shots.includes(p))continue;const x=p.x,y=p.y,item=MG_THROW_ITEMS[p.kind];const bounced=mgThrowStep(p,item,step,scale,floor);\n    if(bounced&&p.bounces\u003c=2){sound('boing');marks.push({x:p.x,y:p.y,text:item.id==='ball'?'통!':'툭!',t:.45});}\n    if(target&&target.open&&p.target===target.id&&(window.SceneEditor?SceneEditor.behindCrosses(x,y,p.x,p.y,target.x,target.hitY,rx*1.15,ry*1.2,actorSize):mgThrowCrosses(x,y,p.x,p.y,target.x,target.hitY,rx*1.15,ry*1.2))){hit(p);break;}\n    if(p.age>4.5||p.x\u003c-70||p.x>w+70||p.y\u003c-h*.5||p.bounces>2||(p.bounces>0&&Math.abs(p.vy)\u003c45&&p.y>floor-5)){\n     shots=shots.filter(x=>x!==p);metrics.misses++;combo=0;\n     if(metrics.misses%2===1)mgSay('아직 여기 있습니다. 다음 소품도 확인해 주세요!','calm');\n    }\n   }\n  }\n  for(const p of shots){p.trail.push({x:p.x,y:p.y});if(p.trail.length>7)p.trail.shift();}\n  stats.textContent=`남은 ${Math.ceil(time)}초　${score}점　연속 ${combo}`;draw(dt);\n });\n const stop=mgCleanup;mgCleanup=()=>{ended=true;pointer=null;shots=[];c.onpointerdown=c.onpointermove=c.onpointerup=c.onpointercancel=c.onlostpointercapture=c.onkeydown=null;stop();};\n}\n\n", "fetch": "/* 물어와! — standalone runner; no main-game state or storage access. */\nclass FetchGame {\n constructor(host,{assets,bg,motion=null,onFinish=()=>{},onEvent=()=>{}}){\n  this.host=host;this.motion=motion;this.assets=assets;this.bg=bg;this.onFinish=onFinish;this.onEvent=onEvent;\n  host.classList.add('fetch-game');host.innerHTML='\u003cdiv class=\"fetch-hud\">\u003cspan class=\"fetch-distance\">물건을 던지는 중…\u003c/span>\u003cspan class=\"fetch-time\">0.0초\u003c/span>\u003c/div>\u003cdiv class=\"fetch-court\">\u003ccanvas width=\"1920\" height=\"1080\" aria-label=\"장애물을 뛰어넘어 물건 회수하기\">\u003c/canvas>\u003cdiv class=\"fetch-call\" aria-live=\"polite\">물어와!\u003c/div>\u003c/div>\u003cdiv class=\"fetch-controls\">\u003cbutton aria-label=\"전진 연타\">\u003cb>전진\u003c/b>\u003csmall>빠르게 연타!\u003c/small>\u003c/button>\u003cbutton aria-label=\"점프\">\u003cb>점프\u003c/b>\u003csmall>장애물을 훌쩍!\u003c/small>\u003c/button>\u003c/div>';\n  this.c=host.querySelector('canvas');this.ctx=this.c.getContext('2d');this.ctx.scale(2,2);this.w=960;this.h=540;this.floor=414;this.x=252;\n  this.s={phase:'throw',age:0,time:0,distance:0,speed:0,y:0,vy:0,jumpAge:0,land:0,stagger:0,invincible:0,collisions:0,cleared:0,anim:0,finishAge:0,frame:0,jumpFrame:0};\n  this.resize=()=>{const r=this.c.parentElement.getBoundingClientRect();if(!r.width||!r.height)return;this.w=540*r.width/r.height;this.x=Math.min(252,this.w*.30);this.c.width=Math.round(this.w*2);this.c.height=1080;this.ctx.setTransform(2,0,0,2,0,0);this.draw();};this.observer=new ResizeObserver(this.resize);this.observer.observe(this.c.parentElement);this.goal=18000;this.obstacles=[];let d=1550;\n  const kinds=[{id:'cuffs',w:66,h:38},{id:'blind',w:88,h:48},{id:'cat',w:76,h:88}];\n  for(let i=0;d\u003cthis.goal-1100;i++){const k=kinds[i%3];this.obstacles.push({...k,d,hit:false,passed:false});d+=1080+(i%4)*125;}\n  this.distanceEl=host.querySelector('.fetch-distance');this.timeEl=host.querySelector('.fetch-time');this.call=host.querySelector('.fetch-call');\n  const [a,b]=host.querySelectorAll('.fetch-controls button');this.buttons=[a,b];\n  const bind=(button,fn)=>{button.onpointerdown=e=>{if(e.pointerType==='mouse'&&e.button!==0)return;e.preventDefault();button.focus({preventScroll:true});fn();};button.onclick=e=>{if(e.detail===0)fn();};};bind(a,()=>this.tap());bind(b,()=>this.jump());\n  this.key=e=>{if(e.repeat||!['ArrowRight',' ','ArrowUp'].includes(e.key))return;e.preventDefault();e.key==='ArrowRight'?this.tap():this.jump();};host.tabIndex=0;host.addEventListener('keydown',this.key);\n  this.stopped=false;this.last=performance.now();const loop=now=>{if(this.stopped)return;const dt=Math.min(.035,(now-this.last)/1000);this.last=now;if(!document.hidden&&!window.MEDIA_PAUSED)this.step(dt);this.raf=requestAnimationFrame(loop);};this.raf=requestAnimationFrame(loop);this.draw();\n }\n tap(){const s=this.s;if(s.phase!=='run')return false;s.speed=Math.min(900,s.speed+95);this.onEvent('tap');return true;}\n jump(){const s=this.s;if(s.phase!=='run'||s.y>0||s.vy>0||s.land>0||s.stagger>.15)return false;s.vy=605;s.jumpAge=0;s.land=0;this.onEvent('jump');return true;}\n say(text,seconds=.9){this.call.textContent=text;this.call.classList.add('show');this.callUntil=this.s.age+seconds;}\n step(dt){\n  if(this.stopped||this.s.phase==='done')return;const s=this.s;s.age+=dt;\n  if(this.callUntil&&s.age>this.callUntil){this.call.classList.remove('show');this.callUntil=0;}\n  if(s.phase==='throw'){\n   if(s.age\u003c.12)this.say('물어와!',1.2);\n   if(s.age>=1.4){s.phase='run';this.say('전진 연타!  장애물은 점프!',1.5);this.onEvent('start');}\n  }else if(s.phase==='run'){\n   s.time+=dt;s.stagger=Math.max(0,s.stagger-dt);s.invincible=Math.max(0,s.invincible-dt);s.land=Math.max(0,s.land-dt);\n   s.speed=Math.max(0,s.speed-(s.stagger>0?300:155)*dt);s.distance=Math.min(this.goal,s.distance+s.speed*dt);s.anim+=dt*(2+s.speed/95);\n   if(s.vy>0||s.y>0){s.jumpAge+=dt;s.y+=s.vy*dt;s.vy-=1650*dt;if(s.y\u003c=0){s.y=0;s.vy=0;s.land=.20;this.onEvent('land');}}\n   const crouch=s.jumpAge\u003c.055&&s.vy>0;s.jumpFrame=s.land>0?3:crouch?0:s.vy>70?1:2;\n   s.frame=Math.floor(s.anim)%4;\n   for(const o of this.obstacles){const dx=o.d-s.distance;if(!o.hit&&!o.passed&&Math.abs(dx)\u003co.w*.5+48&&s.y\u003co.h-8&&s.invincible\u003c=0){o.hit=true;s.collisions++;s.speed*=.38;s.stagger=.38;s.invincible=.8;this.say(['앗! 발이 꼬였습니다!','으악, 이게 왜 여기에!','넘을 수 있었는데…!'][s.collisions%3]);this.onEvent('collision');}if(!o.passed&&dx\u003c-110){o.passed=true;if(!o.hit){s.cleared++;this.say(s.cleared%3===0?'훌쩍! 완벽한 착지입니다!':'슝!',.45);this.onEvent('clear');}}}\n   if(s.distance>=this.goal){s.phase='return';s.finishAge=0;this.say('물었습니다! 돌아갑니다!!',1.1);this.onEvent('fetch');}\n  }else if(s.phase==='return'){\n   s.finishAge+=dt;s.anim+=dt*11;if(s.finishAge>1.15){s.phase='done';this.buttons.forEach(b=>b.disabled=true);const score=Math.max(100,Math.round(1400-s.time*12-s.collisions*75));this.onFinish({score,time:s.time,collisions:s.collisions,cleared:s.cleared,success:true});}\n  }\n  this.distanceEl.textContent=s.phase==='throw'?'회수 준비!':s.phase==='return'||s.phase==='done'?'회수 성공!':`남은 ${Math.max(0,Math.ceil((this.goal-s.distance)/100))}m`;\n  this.timeEl.textContent=s.time.toFixed(1)+'초';this.draw();\n }\n image(im,x,y,w,h,flip=false){if(!im?.naturalWidth)return;const c=this.ctx;c.save();c.translate(x,y);if(flip)c.scale(-1,1);c.drawImage(im,-w/2,-h,w,h);c.restore();}\n draw(){\n  const c=this.ctx,s=this.s,w=this.w,h=this.h;c.clearRect(0,0,w,h);\n  // Foreground and far wall share distance, with a 20% parallax wall.\n  if(window.MEDIA_BACKGROUND){}\n  else if(this.bg?.naturalWidth){const bw=h*this.bg.naturalWidth/this.bg.naturalHeight,offset=(s.distance*.2)%bw;for(let i=-1;i\u003c=Math.ceil(w/bw)+1;i++)c.drawImage(this.bg,i*bw-offset,0,bw,h);}\n  else{c.fillStyle='#cbe7dd';c.fillRect(0,0,w,h);}\n  c.fillStyle='#fff4d51f';c.fillRect(0,0,w,h);\n  const fh=h-this.floor+20,fw=fh*3,offset=s.distance%(fw*2);\n  for(let i=-2;i\u003cMath.ceil(w/fw)+3;i++){const im=this.assets[i%2===0?'floor':'floor-mirror'];if(im?.naturalWidth)c.drawImage(im,i*fw-offset,this.floor-10,fw,fh);}\n  c.fillStyle='#6d3c2938';c.fillRect(0,this.floor-10,w,6);\n  for(const o of this.obstacles){const x=this.x+o.d-s.distance;if(x\u003c-100||x>w+100)continue;c.save();c.globalAlpha=o.hit?.42:1;c.fillStyle='#4b35423b';c.beginPath();c.ellipse(x,this.floor+6,o.w*.65,8,0,0,Math.PI*2);c.fill();this.image(this.assets[o.id],x,this.floor,o.w,o.h);c.restore();}\n  const retrieved=s.phase==='return'||s.phase==='done',charX=retrieved?this.x-s.finishAge*490:this.x;\n  c.fillStyle='#3a34383f';c.beginPath();c.ellipse(charX,this.floor+4,72-s.y*.12,12-s.y*.014,0,0,Math.PI*2);c.fill();\n  const moving=s.speed>8,air=s.y>0||s.vy>0||s.land>0;let im=this.assets[(air?'jump':'run')+((air?s.jumpFrame:moving?Math.floor(s.anim)%4:0)+1)];\n  c.save();if(s.invincible>0)c.globalAlpha=.7+Math.sin(s.age*35)*.3;\n  if(this.motion&&this.assets['crawl-sheet']?.naturalWidth&&this.assets['jump-sheet']?.naturalWidth){\n   const action=air?'jump':'crawl',m=this.motion[action];\n   // Frame positions contain lift already. Anchor the current contact point to physics ground.\n   const index=air?(s.land>0?Math.min(19,15+Math.floor((.20-s.land)/.20*5)):Math.min(14,Math.floor(s.jumpAge/(2*605/1650)*15))):(moving||retrieved?Math.floor(s.anim*m.fps*1.25/11)%m.frames:0);\n   const scale=260/382*m.relativeScale,foot=m.ground[index],sheet=this.assets[action+'-sheet'];\n   c.save();c.translate(charX,this.floor+7-s.y);if(retrieved)c.scale(-1,1);\n   c.drawImage(sheet,(index%m.cols)*m.frame_w,Math.floor(index/m.cols)*m.frame_h,m.frame_w,m.frame_h,-m.center[index]*scale,-foot*scale,m.frame_w*scale,m.frame_h*scale);c.restore();\n   this.spriteState={action,index,scale,footSize:m.footLength*scale,flip:retrieved,ground:this.floor+7-s.y,outfit:window.GAME_SCENE?.outfit};\n  }else this.image(im,charX,this.floor+7-s.y,260,334,!retrieved);c.restore();\n  if(s.phase==='throw'){const q=Math.min(1,s.age/1.2),x=this.x+50+q*950,y=this.floor-110-Math.sin(q*Math.PI)*240;this.image(this.assets.duck,x,y,54,54);}\n  else if(this.goal-s.distance\u003c950&&!retrieved){const x=this.x+this.goal-s.distance;this.image(this.assets.duck,x,this.floor,58,58);c.fillStyle='#fff8da';c.font='bold 18px system-ui';c.textAlign='center';c.fillText('발견!',x,this.floor-70);}\n  if(retrieved)this.image(this.assets.duck,charX-90,this.floor-70,45,45);\n  if(s.phase==='run'&&s.speed>610&&s.y===0){c.strokeStyle=